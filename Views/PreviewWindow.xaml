<Window x:Class="Keyloom.Views.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Keyloom.Views"
        Title="Preview" Style="{StaticResource {x:Type Window}}" Width="640" Height="500" MinWidth="520" MinHeight="400" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource ShellBrush}" CornerRadius="8">
    <Grid>
      <Rectangle Fill="{StaticResource AuroraBrush}" IsHitTestVisible="False"/>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
          <Path Data="{StaticResource IconPlay}" Fill="{StaticResource AccentBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="TitleText" Text="Preview" FontSize="12" Foreground="#2C4A60" VerticalAlignment="Center"/>
        </StackPanel>
        <Button IsCancel="True" Style="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" AutomationProperties.Name="Close">
          <Path Data="{StaticResource IconClose}" Style="{StaticResource ChromeIcon}"/>
        </Button>
        <Grid Grid.Row="1" Margin="16,2,16,14" Style="{StaticResource ShellContent}">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="0" Effect="{StaticResource CardShadow}" ClipToBounds="True">
            <Grid>
              <local:PathPreview x:Name="Route"/>
              <TextBlock x:Name="EmptyText" Text="This sequence has no pointer positions to draw." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Click="Play_Click" Style="{StaticResource PrimaryButton}" MinWidth="84" Margin="0,0,12,0" AutomationProperties.Name="Play or pause">
              <StackPanel Orientation="Horizontal"><Path x:Name="PlayIcon" Data="{StaticResource IconPlay}" Fill="White" Width="9" Height="10" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="PlayText" Text="Play"/></StackPanel>
            </Button>
            <Slider x:Name="TimeSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" IsMoveToPointEnabled="True" ValueChanged="Time_Changed" AutomationProperties.Name="Preview time"/>
            <TextBlock x:Name="TimeText" Grid.Column="2" Text="0.0 s / 0.0 s" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="96" TextAlignment="Right"/>
          </Grid>
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="SpeedBox" Width="84" SelectedIndex="2" SelectionChanged="Speed_Changed" ToolTip="Preview speed">
              <ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/>
            </ComboBox>
            <CheckBox x:Name="ScreenBox" Grid.Column="1" Content="Show on screen" Margin="14,0,0,0" VerticalAlignment="Center" Checked="Screen_Changed" Unchecked="Screen_Changed" ToolTip="Draw the route where it will run. Clicks pass through."/>
            <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="StepText" TextTrimming="CharacterEllipsis" FontSize="12"/>
              <Border x:Name="DelayTrack" Height="4" CornerRadius="2" Background="#1F0F6CBD" Margin="0,4,0,0">
                <Border x:Name="DelayBar" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
              </Border>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="NoteText" Grid.Row="3" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="Planned positions only: preview never moves your pointer or sends input. Moved buttons, resized windows or a game camera can change the real result."/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
