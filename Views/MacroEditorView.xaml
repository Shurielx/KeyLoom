<UserControl x:Class="Keyloom.Views.MacroEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:local="clr-namespace:Keyloom.Views"
             Foreground="{DynamicResource InkBrush}">
  <UserControl.Resources>
    <local:StepViewConverter x:Key="StepView"/>
    <local:StepLayoutConverter x:Key="StepLayout"/>
    <local:HiddenWhenTrueConverter x:Key="HiddenWhenTrue"/>
    <Style x:Key="RowTool" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="1,0,0,0"/>
    </Style>
    <Style x:Key="InlineLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Inspector fields: a label above its box, so they fit a narrow column -->
    <Style x:Key="StackLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
      <Setter Property="Margin" Value="0,12,0,5"/>
    </Style>
    <Style x:Key="InspectorTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <!-- A More options section: a line above it, what it holds while closed, and its own surface while open -->
    <Style x:Key="MoreSection" TargetType="Border">
      <Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
      <Setter Property="Margin" Value="0,16,0,0"/><Setter Property="Padding" Value="0,10,0,0"/>
    </Style>
    <Style x:Key="MoreBox" TargetType="Border">
      <Setter Property="Margin" Value="0,8,0,0"/><Setter Property="Padding" Value="12,0,12,12"/><Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Unit" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="MacroForm">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Icon, name, shortcut and what the macro does -->
    <Border Style="{StaticResource Card}" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button x:Name="IconButton" Grid.RowSpan="2" Click="Icon_Click" Style="{StaticResource IconButton}" Width="56" Height="56" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="Change icon" AutomationProperties.Name="Change icon">
          <Grid Width="50" Height="50">
            <Border Style="{StaticResource IconTile}" Width="50" Height="50" CornerRadius="12"/>
            <local:MacroIcon x:Name="EditorIcon" SymbolSize="21" Foreground="{DynamicResource AccentBrush}"/>
            <Border Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Background="{DynamicResource BlueButtonBrush}" BorderBrush="{DynamicResource SheetBrush}" BorderThickness="2">
              <Path Data="{StaticResource IconEdit}" Fill="White" Width="8" Height="8" Stretch="Uniform"/>
            </Border>
          </Grid>
        </Button>
        <Popup x:Name="IconPopup" PlacementTarget="{Binding ElementName=IconButton}" Placement="Bottom" VerticalOffset="4" HorizontalOffset="-10" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
          <local:IconPicker x:Name="IconChooser" Changed="IconChooser_Changed" CloseRequested="IconChooser_CloseRequested" Failed="IconChooser_Failed"/>
        </Popup>
        <TextBox x:Name="MacroNameTextBox" Grid.Column="1" MaxLength="80" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Macro name" ToolTip="Name"/>
        <Grid Grid.Column="2" VerticalAlignment="Center">
          <TextBox x:Name="ShortcutTextBox" IsReadOnly="True" Cursor="Hand" Padding="8,6,30,6" PreviewKeyDown="Shortcut_PreviewKeyDown" GotKeyboardFocus="Shortcut_Focused" LostKeyboardFocus="Shortcut_Unfocused" ToolTip="Click here and press a shortcut" AutomationProperties.Name="Shortcut"/>
          <Button x:Name="ClearShortcutButton" Click="ClearShortcut_Click" Style="{StaticResource IconButton}" Width="24" Height="24" MinHeight="0" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="Remove shortcut" AutomationProperties.Name="Remove shortcut">
            <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="9" Height="9"/>
          </Button>
        </Grid>
        <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
          <Border Style="{StaticResource SegmentBar}" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="RepeatRadio" GroupName="Mode" Style="{StaticResource Segment}" Checked="Mode_Changed" ToolTip="Click or press again and again">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRepeat}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Repeat"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="HoldRadio" GroupName="Mode" Style="{StaticResource Segment}" Checked="Mode_Changed" ToolTip="Keep a key or button held down">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconHold}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Hold"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="SequenceRadio" GroupName="Mode" Style="{StaticResource Segment}" Checked="Mode_Changed" ToolTip="Play steps you record or build">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconBolt}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="10" Height="12" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Sequence"/></StackPanel>
              </RadioButton>
              <RadioButton x:Name="ScriptRadio" GroupName="Mode" Style="{StaticResource Segment}" Checked="Mode_Changed" Visibility="Collapsed" ToolTip="Experimental: write what the macro does in JavaScript">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCode}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="12" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Script"/></StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
          <TextBlock x:Name="ModeText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- What the macro does on the left, the picked step and run settings on the right. Narrow windows stack them. -->
    <Grid x:Name="Body" Grid.Row="1" Margin="0,10,0,0" SizeChanged="Body_SizeChanged">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="320"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="InspectorRow" Height="0"/></Grid.RowDefinitions>

      <!-- Repeat and hold: which input -->
      <ScrollViewer x:Name="TargetScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border x:Name="TargetPanel" Style="{StaticResource Card}" VerticalAlignment="Top">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Input" Style="{StaticResource InlineLabel}"/>
            <Border Grid.Column="1" Style="{StaticResource SegmentBar}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="MouseRadio" GroupName="Target" Style="{StaticResource Segment}" Checked="Target_Changed">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconMouse}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="10" Height="13" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Mouse"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="KeyboardRadio" GroupName="Target" Style="{StaticResource Segment}" Checked="Target_Changed">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconKeyboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="11" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Keyboard"/></StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
            <TextBlock x:Name="ButtonLabel" Grid.Row="1" Text="Button" Style="{StaticResource InlineLabel}" Margin="0,12,8,0"/>
            <Border x:Name="MouseButtonPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource SegmentBar}" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="Button" Style="{StaticResource Segment}" Content="Left" Tag="Left" MinWidth="58"/>
                <RadioButton GroupName="Button" Style="{StaticResource Segment}" Content="Right" Tag="Right" MinWidth="58"/>
                <RadioButton GroupName="Button" Style="{StaticResource Segment}" Content="Middle" Tag="Middle" MinWidth="58"/>
                <RadioButton GroupName="Button" Style="{StaticResource Segment}" Content="Back" Tag="X1" ToolTip="X1 side button"/>
                <RadioButton GroupName="Button" Style="{StaticResource Segment}" Content="Forward" Tag="X2" ToolTip="X2 side button"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="KeyLabel" Grid.Row="1" Text="Key" Style="{StaticResource InlineLabel}" Margin="0,12,8,0" Visibility="Collapsed"/>
            <StackPanel x:Name="KeyPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
              <TextBox x:Name="TargetKeyTextBox" Width="190"/>
              <TextBlock Text="Space, F8, LeftCtrl, Ctrl+C" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <Grid x:Name="PointRow" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Where" Style="{StaticResource InlineLabel}"/>
              <CheckBox x:Name="UsePointBox" Grid.Column="1" Content="At a chosen point" Checked="UsePoint_Changed" Unchecked="UsePoint_Changed" ToolTip="Off uses wherever the pointer is."/>
              <TextBlock x:Name="PointText" Grid.Column="2" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0"/>
              <Button x:Name="PickButton" Grid.Column="3" Click="PickPoint_Click" Padding="10,4" ToolTip="Click a point in another window. Esc cancels.">
                <StackPanel Orientation="Horizontal"><Grid Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"/><Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}"/></Grid><TextBlock Text="Pick point"/></StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>
      </ScrollViewer>

      <!-- Sequence: the steps take all the height there is -->
      <Border x:Name="SequencePanel" Style="{StaticResource Card}" PreviewKeyDown="Steps_KeyDown" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock Text="Steps" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="StepCountText" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Click="Record_Click" Margin="0,0,6,0" Padding="11,4" ToolTip="Record mouse and keyboard input">
                <StackPanel Orientation="Horizontal"><Grid Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource RecordHaloBrush}"/><Ellipse Width="6" Height="6" Fill="{DynamicResource RecordBrush}"/></Grid><TextBlock Text="Record"/></StackPanel>
              </Button>
              <Button x:Name="BuilderButton" Click="Builder_Click" Margin="0,0,6,0" Padding="11,4" Visibility="Collapsed" ToolTip="Experimental: see the steps on the screen and move their points">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFlask}" Style="{StaticResource AccentIcon}" Width="10" Height="11" Margin="0,0,7,0"/><TextBlock Text="On screen"/></StackPanel>
              </Button>
              <Button x:Name="ToScriptButton" Click="ToScript_Click" Margin="0,0,6,0" Padding="11,4" Visibility="Collapsed" ToolTip="Experimental: write these steps as a script that plays the same">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCode}" Style="{StaticResource AccentIcon}" Width="13" Height="12" Margin="0,0,7,0"/><TextBlock Text="Turn into script"/></StackPanel>
              </Button>
              <Button x:Name="AddStepButton" Click="AddStepMenu_Click" Style="{StaticResource PrimaryButton}" Padding="11,4">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlus}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Add step"/><Path Data="M0 0L4 4L8 0" Stroke="White" StrokeThickness="1.4" Width="8" Height="4" Stretch="Uniform" Margin="8,1,0,0" VerticalAlignment="Center"/></StackPanel>
                <Button.ContextMenu>
                  <ContextMenu x:Name="AddStepMenu" Placement="Bottom">
                    <MenuItem Header="Click" Tag="MouseClick" Click="AddStep_Click"><MenuItem.Icon><Path Data="{StaticResource IconMouse}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Click at a point in a window..." Tag="Click" Click="PickPoint_Click" ToolTip="Adds a move to the point and a click"><MenuItem.Icon><Path Data="{StaticResource IconCursorMove}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Press a key" Tag="KeyPress" Click="AddStep_Click"><MenuItem.Icon><Path Data="{StaticResource IconKeyboard}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Wait" Tag="Delay" Click="AddStep_Click"><MenuItem.Icon><Path Data="{StaticResource IconClock}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Type text" Tag="Text" Click="AddStep_Click"><MenuItem.Icon><Path Data="{StaticResource IconText}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="Click on something on the screen..." Tag="ClickTarget" Click="AddTargetStep_Click" ToolTip="Finds a picture or a color on the screen and clicks it, wherever it is"><MenuItem.Icon><Path Data="{StaticResource IconImage}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Wait until something shows..." Tag="WaitUntil" Click="AddTargetStep_Click" ToolTip="Waits for a picture or a color to show up on the screen, or to go away"><MenuItem.Icon><Path Data="{StaticResource IconClock}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="Cursor position" Tag="MousePosition" Click="AddStep_Click"><MenuItem.Icon><Path Data="{StaticResource IconTarget}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Cursor to a point in a window..." Tag="Move" Click="PickPoint_Click" ToolTip="Adds only the move, without a click"><MenuItem.Icon><Path Data="{StaticResource IconTarget}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Move cursor by" Tag="MouseMove" Click="AddStep_Click"><MenuItem.Icon><Path Data="{StaticResource IconMove}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Scroll" Tag="MouseScroll" Click="AddStep_Click"><MenuItem.Icon><Path Data="{StaticResource IconScroll}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="Hold or release a button" Tag="MouseDown" Click="AddStep_Click"><MenuItem.Icon><Path Data="{StaticResource IconHold}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Hold or release a key" Tag="KeyDown" Click="AddStep_Click"><MenuItem.Icon><Path Data="{StaticResource IconHold}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="Click a cell in a grid..." Tag="ClickCell" Click="AddGridStep_Click" ToolTip="Reads the numbers in a grid and clicks the highest, the lowest, a given number or an empty cell"><MenuItem.Icon><Path Data="{StaticResource IconGrid}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Drag a matching pair in a grid..." Tag="DragPair" Click="AddGridStep_Click" ToolTip="Reads the numbers in a grid and drags one of two equal numbers onto the other, lowest first"><MenuItem.Icon><Path Data="{StaticResource IconGrid}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="If something is on the screen..." Click="AddIf_Click" ToolTip="Plays the picked steps only when a picture or a color is on the screen, with an Else for when it is not"><MenuItem.Icon><Path Data="{StaticResource IconTarget}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="AddAiIfItem" Header="If the AI says yes..." Click="AddAiIf_Click" Visibility="Collapsed" ToolTip="Experimental: plays the picked steps only when the AI, looking at the screen, answers yes to your question"><MenuItem.Icon><Path Data="{StaticResource IconAi}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Group" Click="AddGroup_Click" InputGestureText="Ctrl+G" ToolTip="Groups the picked steps, or adds an empty group"><MenuItem.Icon><Path Data="{StaticResource IconGroup}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </Grid>
          <!-- Column names, lined up with the rows below -->
          <Grid x:Name="StepHeader" Grid.Row="1" Margin="8,0,24,5" TextElement.FontSize="11.5" TextElement.Foreground="{DynamicResource MutedBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="#" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="Step"/>
            <TextBlock Grid.Column="2" Text="Starts at" Margin="0,0,52,0" ToolTip="When the step plays in one run, counting the waits before it"/>
          </Grid>
          <Grid Grid.Row="2">
            <ListBox x:Name="ActionsListBox" MinHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended" SelectionChanged="Step_Selected" MouseDoubleClick="Steps_DoubleClick" ContextMenuOpening="Steps_ContextMenuOpening"
                     PreviewMouseLeftButtonDown="Steps_MouseDown" PreviewMouseMove="Steps_MouseMove" PreviewMouseLeftButtonUp="Steps_MouseUp" LostMouseCapture="Steps_LostCapture"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
              <!-- Filled when it opens, from what is picked -->
              <ListBox.ContextMenu><ContextMenu x:Name="StepMenu"/></ListBox.ContextMenu>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="4,0"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                      <Border x:Name="Hover" CornerRadius="4" Background="{DynamicResource ListHoverBrush}" Opacity="0"/>
                      <Border x:Name="Selected" CornerRadius="4" Background="{DynamicResource ListSelectedBrush}" Opacity="0"/>
                      <Border x:Name="Pip" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,0,0,0" Background="{DynamicResource AccentBrush}" RenderTransformOrigin=".5,.5">
                        <Border.RenderTransform><ScaleTransform x:Name="PipScale" ScaleY="0"/></Border.RenderTransform>
                      </Border>
                      <ContentPresenter Margin="{TemplateBinding Padding}"/>
                      <Rectangle Height="1" VerticalAlignment="Bottom" Margin="6,0" Fill="{DynamicResource DividerBrush}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                          <DoubleAnimation Storyboard.TargetName="PipScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOutStrong}"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                          <DoubleAnimation Storyboard.TargetName="PipScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.12"/>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate></Setter.Value></Setter>
                  <!-- Steps inside a collapsed group are hidden -->
                  <Setter Property="Visibility">
                    <Setter.Value>
                      <MultiBinding Converter="{StaticResource StepLayout}" ConverterParameter="Visibility">
                        <Binding/>
                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                        <Binding Path="StepsRevision" RelativeSource="{RelativeSource AncestorType=local:MacroEditorView}"/>
                      </MultiBinding>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <Grid x:Name="Row" MinHeight="36">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <!-- Step number; a checkbox takes its place on hover and sits beside it while several steps are picked -->
                  <Grid x:Name="Lead" Width="34">
                  <Path x:Name="Grip" Data="{StaticResource IconGrip}" Fill="{DynamicResource MutedBrush}" Width="7" Height="11" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" Visibility="Hidden" Cursor="SizeAll" ToolTip="Drag to move"/>
                  <CheckBox x:Name="Pick" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"
                            IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" AutomationProperties.Name="Pick step"/>
                  <TextBlock x:Name="Number" Style="{StaticResource Muted}" FontSize="12" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource StepLayout}" ConverterParameter="Number">
                        <Binding/>
                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                        <Binding Path="StepsRevision" RelativeSource="{RelativeSource AncestorType=local:MacroEditorView}"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  </Grid>
                  <!-- Lines tying a group's steps to its header -->
                  <local:StepRail Grid.Column="1" Grid.ColumnSpan="2" Brush="{DynamicResource StepGroupBrush}" Opacity=".55" IsHitTestVisible="False">
                    <local:StepRail.Info>
                      <MultiBinding Converter="{StaticResource StepLayout}" ConverterParameter="Rail">
                        <Binding/>
                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                        <Binding Path="StepsRevision" RelativeSource="{RelativeSource AncestorType=local:MacroEditorView}"/>
                      </MultiBinding>
                    </local:StepRail.Info>
                  </local:StepRail>
                  <!-- Tone icon, title and detail, indented by the groups around the step -->
                  <Grid x:Name="Body" Grid.Column="1" Grid.ColumnSpan="2" DataContext="{Binding Converter={StaticResource StepView}}" Style="{StaticResource StepTone}">
                    <Grid.Margin>
                      <MultiBinding Converter="{StaticResource StepLayout}" ConverterParameter="Indent">
                        <Binding Path="DataContext" ElementName="Row"/>
                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                        <Binding Path="StepsRevision" RelativeSource="{RelativeSource AncestorType=local:MacroEditorView}"/>
                      </MultiBinding>
                    </Grid.Margin>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid x:Name="Tile" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                      <Border x:Name="TileFill" CornerRadius="6" Background="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Opacity=".16"/>
                      <Path Data="{Binding Icon}" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Width="12" Height="12" Stretch="Uniform"/>
                    </Grid>
                    <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border x:Name="Chip" Grid.Column="2" Padding="0" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" BorderBrush="{DynamicResource KeycapBorderBrush}">
                      <TextBlock x:Name="Detail" Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <TextBlock x:Name="EndLabel" Grid.Column="2" Style="{StaticResource Muted}" FontSize="11.5" FontStyle="Italic" VerticalAlignment="Center" Visibility="Collapsed">
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource StepLayout}" ConverterParameter="Children">
                          <Binding Path="DataContext" ElementName="Row"/>
                          <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                          <Binding Path="StepsRevision" RelativeSource="{RelativeSource AncestorType=local:MacroEditorView}"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <!-- Group headers fold their steps away -->
                    <Button x:Name="Fold" Grid.Column="3" Click="Fold_Click" Tag="{Binding DataContext, ElementName=Row}" Style="{StaticResource IconButton}" MinHeight="0" Height="22" Width="Auto" Padding="6,0" Margin="6,0,0,0"
                            HorizontalAlignment="Left" Visibility="Collapsed" ToolTip="Fold or unfold the group (double-click the header)" AutomationProperties.Name="Fold group">
                      <StackPanel Orientation="Horizontal">
                        <Path x:Name="FoldChevron" Data="{StaticResource IconChevron}" Fill="{DynamicResource MutedBrush}" Width="8" Height="8" Stretch="Uniform" RenderTransformOrigin=".5,.5" Margin="0,0,6,0">
                          <Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform>
                        </Path>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource StepLayout}" ConverterParameter="Children">
                        <Binding Path="DataContext" ElementName="Row"/>
                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                        <Binding Path="StepsRevision" RelativeSource="{RelativeSource AncestorType=local:MacroEditorView}"/>
                      </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Button>
                  </Grid>
                  <!-- When the step plays in one run -->
                  <TextBlock x:Name="StartsAt" Grid.Column="3" Style="{StaticResource Muted}" FontSize="12" Typography.NumeralAlignment="Tabular" MinWidth="58" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,2,0">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource StepLayout}" ConverterParameter="Time">
                        <Binding/>
                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                        <Binding Path="StepsRevision" RelativeSource="{RelativeSource AncestorType=local:MacroEditorView}"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <StackPanel x:Name="Tools" Grid.Column="4" Orientation="Horizontal" Visibility="Hidden">
                    <Button Click="RowDuplicate_Click" Tag="{Binding}" Style="{StaticResource RowTool}" ToolTip="Duplicate" AutomationProperties.Name="Duplicate step"><Path Data="{StaticResource IconCopy}" Style="{StaticResource Icon}" Width="11" Height="11"/></Button>
                    <Button Click="RowRemove_Click" Tag="{Binding}" Style="{StaticResource RowTool}" ToolTip="Remove (Delete)" AutomationProperties.Name="Remove step"><Path Data="{StaticResource IconTrash}" Fill="{DynamicResource DangerIconBrush}" Width="11" Height="11" Stretch="Uniform"/></Button>
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                    <Setter TargetName="Pick" Property="Visibility" Value="Visible"/><Setter TargetName="Number" Property="Visibility" Value="Hidden"/><Setter TargetName="Grip" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsMultiSelect, RelativeSource={RelativeSource AncestorType=local:MacroEditorView}}" Value="True">
                    <Setter TargetName="Lead" Property="Width" Value="58"/><Setter TargetName="Grip" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="Pick" Property="Visibility" Value="Visible"/><Setter TargetName="Pick" Property="HorizontalAlignment" Value="Left"/><Setter TargetName="Pick" Property="Margin" Value="6,0,0,0"/>
                    <Setter TargetName="Number" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <!-- Waits stay quiet: no title, just a soft duration chip, so the rhythm of the macro shows at a glance. -->
                  <DataTrigger Binding="{Binding DataContext.IsWait, ElementName=Tile}" Value="True">
                    <Setter TargetName="Row" Property="MinHeight" Value="28"/>
                    <Setter TargetName="Title" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TileFill" Property="Opacity" Value="0"/>
                    <Setter TargetName="Chip" Property="Padding" Value="8,1"/>
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource DividerBrush}"/>
                    <Setter TargetName="Detail" Property="FontSize" Value="12"/>
                  </DataTrigger>
                  <!-- Group headers carry the group's name and settings; group ends are a slim closing corner. -->
                  <DataTrigger Binding="{Binding DataContext.IsGroup, ElementName=Tile}" Value="True">
                    <Setter TargetName="Fold" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Detail" Property="FontSize" Value="12"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DataContext.Collapsed, ElementName=Tile}" Value="True">
                    <Setter TargetName="FoldChevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DataContext.IsGroupEnd, ElementName=Tile}" Value="True">
                    <Setter TargetName="Row" Property="MinHeight" Value="22"/>
                    <Setter TargetName="Tile" Property="Height" Value="12"/>
                    <Setter TargetName="Tile" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="Title" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Chip" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="EndLabel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tools" Property="Width" Value="0"/>
                  </DataTrigger>
                  <!-- Keys read as keycaps. -->
                  <DataTrigger Binding="{Binding DataContext.IsKey, ElementName=Tile}" Value="True">
                    <Setter TargetName="Chip" Property="Padding" Value="7,1"/>
                    <Setter TargetName="Chip" Property="CornerRadius" Value="4"/>
                    <Setter TargetName="Chip" Property="BorderThickness" Value="1,1,1,2"/>
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource KeycapBrush}"/>
                    <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource InkBrush}"/>
                    <Setter TargetName="Detail" Property="FontSize" Value="12"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="Tools" Property="Visibility" Value="Visible"/></DataTrigger>
                  <!-- With several steps picked, tools show only on the row under the pointer. -->
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                      <Condition Binding="{Binding IsMultiSelect, RelativeSource={RelativeSource AncestorType=local:MacroEditorView}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Tools" Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                  <!-- Group ends go with their group; they have nothing to pick or number. -->
                  <DataTrigger Binding="{Binding DataContext.IsGroupEnd, ElementName=Tile}" Value="True">
                    <Setter TargetName="Pick" Property="Visibility" Value="Hidden"/><Setter TargetName="Grip" Property="Visibility" Value="Hidden"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <!-- + on the line between two rows inserts a wait there -->
            <Canvas x:Name="GapLayer">
              <Rectangle x:Name="GapLine" Canvas.Left="58" Height="1" Fill="{DynamicResource AccentBrush}" Opacity=".45" IsHitTestVisible="False" Visibility="Collapsed"/>
              <Button x:Name="GapButton" Canvas.Left="6" Height="16" Click="GapButton_Click" Cursor="Hand" Focusable="False" Visibility="Collapsed" ToolTip="Insert a wait here" AutomationProperties.Name="Insert a wait here">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" CornerRadius="8" Padding="6,0,8,0" Background="{DynamicResource BlueButtonBrush}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPlus}" Fill="White" Width="8" Height="8" Stretch="Uniform" Margin="0,0,4,0"/>
                        <TextBlock Text="Wait" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Opacity" Value=".85"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Canvas>
            <!-- Drag feedback: where the steps will land and how many are moving -->
            <Canvas x:Name="DropLayer" IsHitTestVisible="False" ClipToBounds="True">
              <Grid x:Name="DropLine" Height="8" Canvas.Left="6" Visibility="Collapsed">
                <Rectangle Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <Ellipse Width="8" Height="8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="{DynamicResource SheetBrush}" HorizontalAlignment="Left"/>
              </Grid>
              <Border x:Name="DragBadge" Padding="9,3" CornerRadius="10" Background="{DynamicResource BlueButtonBrush}" Visibility="Collapsed">
                <TextBlock x:Name="DragBadgeText" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
              </Border>
            </Canvas>
            <StackPanel x:Name="NoStepsText" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock Text="No steps yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="Record your input or use Add step." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="StripPanel" Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="0 s" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,8,0"/>
            <local:RunStrip x:Name="Strip" Grid.Column="1" Height="22" StepPicked="Strip_StepPicked"/>
            <TextBlock x:Name="StripEnd" Grid.Column="2" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,2,0" Typography.NumeralAlignment="Tabular"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Script: the code takes all the height there is -->
      <Border x:Name="ScriptPanel" Style="{StaticResource Card}" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Script" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Experimental" FontSize="10.5"/></Border>
              </StackPanel>
              <TextBlock Text="JavaScript, played from the top on each run" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ExamplesButton" Click="Examples_Click" Margin="0,0,6,0" Padding="11,4" ToolTip="Start from a ready-made script">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Examples"/><Path Data="M0 0L4 4L8 0" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.4" Width="8" Height="4" Stretch="Uniform" Margin="8,1,0,0" VerticalAlignment="Center"/></StackPanel>
                <Button.ContextMenu><ContextMenu x:Name="ExamplesMenu" Placement="Bottom"/></Button.ContextMenu>
              </Button>
              <Button x:Name="ScriptHelpButton" Click="ScriptHelp_Click" Padding="11,4" ToolTip="Every function a script can use, with examples (F1)">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconHelp}" Style="{StaticResource AccentIcon}" Width="13" Height="13" Margin="0,0,7,0"/><TextBlock Text="Help"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource FieldBorderBrush}" Background="{DynamicResource FieldBrush}" Padding="0,6,4,6">
            <ae:TextEditor x:Name="ScriptBox" ShowLineNumbers="True" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" WordWrap="False"
                           Background="Transparent" Foreground="{DynamicResource InkBrush}" LineNumbersForeground="{DynamicResource MutedBrush}"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Script"/>
          </Border>
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ScriptStatus" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MouseLeftButtonUp="ScriptStatus_Click"/>
            <TextBlock Grid.Column="1" Text="Ctrl+Space suggests · F1 help" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </Grid>
        </Grid>
      </Border>

      <!-- The inspector: the picked step, the route and the run settings -->
      <Border x:Name="Inspector" Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="0">
        <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12">
          <StackPanel x:Name="InspectorStack">
            <TextBlock x:Name="PickHint" Text="Pick a step to change it. Ctrl or Shift picks several." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <!-- One picked step; changes apply as you type -->
            <StackPanel x:Name="StepEditor" Visibility="Collapsed" Margin="0,0,0,16">
              <TextBlock x:Name="StepIndexText" Text="Step 1" Style="{StaticResource InspectorTitle}"/>
              <TextBlock Text="Action" Style="{StaticResource StackLabel}"/>
              <ComboBox x:Name="StepTypeBox" SelectionChanged="StepType_Changed" DisplayMemberPath="Label" SelectedValuePath="Kind" AutomationProperties.Name="Step action"/>
              <TextBlock x:Name="StepValueLabel" Text="Value" Style="{StaticResource StackLabel}"/>
              <Grid x:Name="StepValuePanel">
                <TextBox x:Name="StepValueTextBox" MaxHeight="120" VerticalScrollBarVisibility="Auto" TextChanged="StepField_Changed" AutomationProperties.Name="Step value"/>
                <ComboBox x:Name="StepMouseBox" Visibility="Collapsed" SelectionChanged="StepField_Changed" AutomationProperties.Name="Mouse button"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="X1"/><ComboBoxItem Content="X2"/></ComboBox>
              </Grid>
              <TextBlock x:Name="StepHintText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <!-- Click on target and Wait until: what to find, and how long to look -->
              <ContentControl x:Name="StepTargetHost" Focusable="False" IsTabStop="False">
              <StackPanel x:Name="TargetOptions" Visibility="Collapsed">
                <TextBlock Text="Look for" Style="{StaticResource StackLabel}"/>
                <ComboBox x:Name="TargetBox" SelectionChanged="TargetBox_Changed" AutomationProperties.Name="Target to look for"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button Click="CapturePicture_Click" Padding="10,4" Margin="0,0,6,6" ToolTip="Drag around a button, an icon or text on the screen. Esc cancels.">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconImage}" Style="{StaticResource Icon}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="New picture"/></StackPanel>
                  </Button>
                  <Button Click="PickColor_Click" Padding="10,4" Margin="0,0,6,6" ToolTip="Click a color on the screen. Esc cancels.">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Margin="0,0,7,0" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Text="New color"/></StackPanel>
                  </Button>
                </WrapPanel>
                <Border x:Name="TargetCard" Style="{StaticResource MoreBox}" Margin="0,2,0,0" Padding="12">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="72" Height="52" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource HoverFillBrush}" Margin="0,0,10,0" ClipToBounds="True">
                        <Grid>
                          <Image x:Name="TargetImage" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                          <Border x:Name="TargetSwatch" CornerRadius="5" Margin="6"/>
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="TargetNameTextBox" MaxLength="60" LostKeyboardFocus="TargetName_LostFocus" KeyDown="TargetName_KeyDown" AutomationProperties.Name="Target name"/>
                        <TextBlock x:Name="TargetInfoText" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="Tolerance" Style="{StaticResource StackLabel}"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="60" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Tolerance_Changed" AutomationProperties.Name="Tolerance"/>
                      <TextBlock x:Name="ToleranceText" Grid.Column="1" Style="{StaticResource Unit}" MinWidth="78"/>
                    </Grid>
                    <CheckBox x:Name="NearBox" Content="Only look near where it was" Margin="0,8,0,0" Checked="Near_Changed" Unchecked="Near_Changed" ToolTip="Faster, and it won't find the same thing elsewhere on the screen"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Click="FindNow_Click" Padding="10,4" ToolTip="Looks for it on the screen now, with Keyloom out of the way">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconTarget}" Style="{StaticResource Icon}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="Find it now"/></StackPanel>
                      </Button>
                    </StackPanel>
                    <TextBlock x:Name="FindResultText" TextWrapping="Wrap" Margin="0,6,0,0">
                      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="UntilPanel">
                  <TextBlock x:Name="UntilLabel" Text="Wait until it" Style="{StaticResource StackLabel}"/>
                  <ComboBox x:Name="UntilBox" SelectedIndex="0" SelectionChanged="StepField_Changed" AutomationProperties.Name="Wait until it"><ComboBoxItem Content="Shows up"/><ComboBoxItem Content="Is gone"/></ComboBox>
                </StackPanel>
                <TextBlock x:Name="TimeoutLabel" Text="Keep looking for" Style="{StaticResource StackLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="TimeoutTextBox" Width="72" Text="0" TextChanged="StepField_Changed" AutomationProperties.Name="Time to look"/>
                  <TextBlock x:Name="TimeoutUnit" Text="ms" Style="{StaticResource Unit}"/>
                </StackPanel>
                <CheckBox x:Name="StopIfMissingBox" Margin="0,10,0,0" Checked="StepField_Changed" Unchecked="StepField_Changed"/>
              </StackPanel>
              </ContentControl>
              <!-- Click on a cell and Drag a matching pair: which grid, and what to do in it -->
              <StackPanel x:Name="GridOptions" Visibility="Collapsed">
                <StackPanel x:Name="CellPickPanel">
                  <TextBlock Text="Click the cell with" Style="{StaticResource StackLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="CellPickBox" Width="170" SelectedIndex="0" SelectionChanged="CellPick_Changed" AutomationProperties.Name="Which cell to click">
                      <ComboBoxItem Content="The highest number"/><ComboBoxItem Content="The lowest number"/><ComboBoxItem Content="The number"/><ComboBoxItem Content="Nothing in it"/>
                    </ComboBox>
                    <TextBox x:Name="CellValueTextBox" Width="72" Margin="8,0,0,0" Text="0" TextChanged="StepField_Changed" AutomationProperties.Name="Number to click"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="DragTimePanel">
                  <TextBlock Text="Drag takes" Style="{StaticResource StackLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="DragTimeTextBox" Width="72" Text="150" TextChanged="StepField_Changed" AutomationProperties.Name="Drag time"/>
                    <TextBlock Text="ms · drags the later cell onto the earlier one" Style="{StaticResource Unit}"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="Grid" Style="{StaticResource StackLabel}"/>
                <ComboBox x:Name="GridBox" SelectionChanged="GridBox_Changed" AutomationProperties.Name="Grid to read"/>
                <Button Click="MarkGrid_Click" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left" ToolTip="Drag around the whole grid on the screen. Esc cancels.">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconGrid}" Style="{StaticResource Icon}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="Mark a new grid"/></StackPanel>
                </Button>
                <Border x:Name="GridCard" Style="{StaticResource MoreBox}" Margin="0,8,0,0" Padding="12">
                  <StackPanel>
                    <TextBox x:Name="GridNameTextBox" MaxLength="60" LostKeyboardFocus="GridName_LostFocus" KeyDown="GridName_KeyDown" AutomationProperties.Name="Grid name"/>
                    <TextBlock x:Name="GridInfoText" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8,0,0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBox x:Name="GridRowsTextBox" Width="48" TextChanged="GridSize_Changed" AutomationProperties.Name="Rows"/>
                        <TextBlock Text="rows" Style="{StaticResource Unit}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox x:Name="GridColumnsTextBox" Width="48" TextChanged="GridSize_Changed" AutomationProperties.Name="Columns"/>
                        <TextBlock Text="columns" Style="{StaticResource Unit}"/>
                      </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Moves with" Style="{StaticResource StackLabel}"/>
                    <ComboBox x:Name="GridFollowBox" SelectionChanged="GridFollow_Changed" AutomationProperties.Name="Moves with"
                              ToolTip="When the game moves its board, the grid moves as far as this picture did. Keep the picture where it is now while you pick it."/>
                    <Button Click="ReadGrid_Click" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left" ToolTip="Reads the numbers on the screen now, with Keyloom out of the way">
                      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconGrid}" Style="{StaticResource Icon}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="Read it now"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="GridReadText" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Margin="0,8,0,0" TextWrapping="NoWrap">
                      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="GridReadNote" TextWrapping="Wrap" Margin="0,4,0,0">
                      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
                <CheckBox x:Name="GridStopBox" Content="Stop the macro when there is none" Margin="0,10,0,0" Checked="StepField_Changed" Unchecked="StepField_Changed"/>
              </StackPanel>
              <StackPanel x:Name="MoveOptions" Margin="0,10,0,0" Visibility="Collapsed">
                <Button Click="RepickPoint_Click" Padding="10,4" HorizontalAlignment="Left" ToolTip="Click the new spot in the target window. Esc cancels.">
                  <StackPanel Orientation="Horizontal"><Grid Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"/><Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}"/></Grid><TextBlock Text="Pick the point again"/></StackPanel>
                </Button>
                <CheckBox x:Name="ThenClickBox" Content="Click after moving" Margin="0,10,0,0" Checked="ThenClick_Changed" Unchecked="ThenClick_Changed" ToolTip="Adds or removes a click right after this move"/>
                <Border Style="{StaticResource MoreSection}">
                <StackPanel>
                <ToggleButton x:Name="StepMoreToggle" Style="{StaticResource Disclosure}" Content="More options" HorizontalAlignment="Left"/>
                <TextBlock Text="Where x, y count from, and gliding" Style="{StaticResource Muted}" FontSize="12" Margin="22,2,0,0">
                  <TextBlock.Visibility><Binding Path="IsChecked" ElementName="StepMoreToggle" Converter="{StaticResource HiddenWhenTrue}"/></TextBlock.Visibility>
                </TextBlock>
                <Border Style="{StaticResource MoreBox}" Visibility="{Binding IsChecked, ElementName=StepMoreToggle, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="Measured from" Style="{StaticResource StackLabel}"/>
                  <ComboBox x:Name="StepSpaceBox" SelectedIndex="0" SelectionChanged="StepField_Changed" AutomationProperties.Name="Measured from"><ComboBoxItem Content="The screen"/><ComboBoxItem Content="The target window"/><ComboBoxItem Content="Where the macro started"/></ComboBox>
                  <TextBlock Text="Glide" Style="{StaticResource StackLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="GlideTextBox" Width="64" Text="0" TextChanged="StepField_Changed" AutomationProperties.Name="Glide time"/>
                    <TextBlock Text="ms · 0 jumps there" Style="{StaticResource Unit}"/>
                  </StackPanel>
                </StackPanel>
                </Border>
                </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>

            <!-- A group: its name, how often it plays and the wait it adds between its steps -->
            <StackPanel x:Name="GroupEditor" Visibility="Collapsed" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                  <Border CornerRadius="7" Background="{DynamicResource StepGroupBrush}" Opacity=".16"/>
                  <Path x:Name="GroupIconPath" Data="{StaticResource IconGroup}" Fill="{DynamicResource StepGroupBrush}" Width="12" Height="12" Stretch="Uniform"/>
                </Grid>
                <TextBlock x:Name="GroupTitleText" Grid.Column="1" Text="Group" Style="{StaticResource InspectorTitle}" VerticalAlignment="Center"/>
                <Button x:Name="UngroupButton" Grid.Column="2" Click="Ungroup_Click" Padding="10,4" ToolTip="Keep the steps and remove the group (Ctrl+Shift+G)">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconGroup}" Style="{StaticResource Icon}" Width="11" Height="11" Margin="0,0,7,0"/><TextBlock x:Name="UngroupText" Text="Ungroup"/></StackPanel>
                </Button>
              </Grid>
              <!-- An If: what it checks, using the same target fields as Click on target -->
              <ContentControl x:Name="IfTargetHost" Focusable="False" IsTabStop="False"/>
              <!-- An If that asks the AI a question about the screen -->
              <StackPanel x:Name="IfAskPanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="Question for the AI" Style="{StaticResource FieldLabel}" Margin="0"/>
                  <Border Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Experimental" FontSize="10.5"/></Border>
                </StackPanel>
                <TextBox x:Name="IfQuestionTextBox" Margin="0,6,0,0" TextWrapping="Wrap" MinHeight="56" VerticalContentAlignment="Top" MaxLength="2000" TextChanged="IfQuestion_Changed" AutomationProperties.Name="Question for the AI"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" Text="Ask something with a yes or no answer, like: Is a shop window open? The AI looks at the target window, or at the whole screen, and only answers."/>
                <TextBlock Text="Plays its steps when the answer is" Style="{StaticResource StackLabel}"/>
                <ComboBox x:Name="IfAnswerBox" SelectedIndex="0" SelectionChanged="IfQuestion_Changed" AutomationProperties.Name="Answer that plays the steps"><ComboBoxItem Content="Yes"/><ComboBoxItem Content="No"/></ComboBox>
                <Button Click="AskNow_Click" Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Left" ToolTip="Asks the AI now, with Keyloom out of the way, and shows its answer">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconAi}" Style="{StaticResource AccentIcon}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="Ask it now"/></StackPanel>
                </Button>
                <TextBlock x:Name="AskResultText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
              <Button x:Name="AddElseButton" Click="AddElse_Click" Padding="10,4" Margin="0,12,0,0" HorizontalAlignment="Left" ToolTip="Adds steps that play when this If does not">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" Width="10" Height="10" Margin="0,0,7,0"/><TextBlock Text="Add Else"/></StackPanel>
              </Button>
              <TextBlock x:Name="GroupNameLabel" Text="Name" Style="{StaticResource StackLabel}"/>
              <TextBox x:Name="GroupNameTextBox" MaxLength="80" TextChanged="GroupField_Changed" AutomationProperties.Name="Group name"/>
              <WrapPanel x:Name="GroupTimingPanel">
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="Play" Style="{StaticResource StackLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="GroupRunsTextBox" Width="64" TextChanged="GroupField_Changed" AutomationProperties.Name="Times the group plays"/>
                    <TextBlock Text="times" Style="{StaticResource Unit}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Wait between steps" Style="{StaticResource StackLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="GroupGapTextBox" Width="72" TextChanged="GroupField_Changed" AutomationProperties.Name="Wait between the group's steps"/>
                    <TextBlock Text="ms" Style="{StaticResource Unit}"/>
                  </StackPanel>
                </StackPanel>
              </WrapPanel>
              <TextBlock x:Name="GroupHintText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <!-- What the group does in one sentence, its timing, and the steps inside it -->
              <Border x:Name="GroupInfo" Style="{StaticResource MoreBox}" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock x:Name="GroupSummaryText" TextWrapping="Wrap"/>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Starts at" Style="{StaticResource Muted}" FontSize="11.5"/><TextBlock x:Name="GroupStartText" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="One pass" Style="{StaticResource Muted}" FontSize="11.5"/><TextBlock x:Name="GroupPassText" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="All passes" Style="{StaticResource Muted}" FontSize="11.5"/><TextBlock x:Name="GroupTotalText" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/></StackPanel>
                  </Grid>
                  <TextBlock Text="Inside" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,10,0,4"/>
                  <ItemsControl x:Name="GroupStepsList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,1"/>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Several picked steps, changed together -->
            <StackPanel x:Name="BulkEditor" Visibility="Collapsed" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="BulkTitle" Style="{StaticResource InspectorTitle}"/>
                  <TextBlock x:Name="BulkInfo" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="BulkClear_Click" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="0" VerticalAlignment="Top" ToolTip="Clear selection (Esc)" AutomationProperties.Name="Clear selection">
                  <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="9" Height="9"/>
                </Button>
              </Grid>
              <WrapPanel Margin="0,10,0,0">
                <Button Click="BulkGroup_Click" Padding="10,4" Margin="0,0,6,6" ToolTip="Put the picked steps in a group (Ctrl+G)">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconGroup}" Fill="{DynamicResource StepGroupBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Group"/></StackPanel>
                </Button>
                <Button Click="BulkDuplicate_Click" Padding="10,4" Margin="0,0,6,6" ToolTip="Duplicate (Ctrl+D)">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCopy}" Style="{StaticResource Icon}" Width="11" Height="11" Margin="0,0,7,0"/><TextBlock Text="Duplicate"/></StackPanel>
                </Button>
                <Button Click="BulkDelete_Click" Padding="10,4" Margin="0,0,6,6" ToolTip="Delete (Delete)">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconTrash}" Fill="{DynamicResource DangerIconBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="Delete"/></StackPanel>
                </Button>
              </WrapPanel>
              <StackPanel x:Name="BulkWaitPanel">
                <TextBlock Text="Waits" Style="{StaticResource StackLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="BulkWaitTextBox" Width="72" KeyDown="BulkWait_KeyDown" AutomationProperties.Name="Wait time for picked steps" ToolTip="100 sets, +20 or -20 adds, x1.5 scales"/>
                  <TextBlock Text="ms" Style="{StaticResource Unit}" Margin="6,0,8,0"/>
                  <Button Content="Apply" Click="BulkWait_Click" Padding="10,4"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="BulkButtonPanel">
                <TextBlock Text="Mouse button" Style="{StaticResource StackLabel}"/>
                <ComboBox x:Name="BulkMouseBox" Width="120" HorizontalAlignment="Left" SelectionChanged="BulkMouse_Changed" AutomationProperties.Name="Mouse button for picked steps"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="X1"/><ComboBoxItem Content="X2"/></ComboBox>
              </StackPanel>
              <TextBlock x:Name="BulkHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0" Text="Waits take 100, +20, -20 or x1.5 · Ctrl+G groups · Ctrl+C, Ctrl+X, Ctrl+V, Ctrl+D · Ctrl+Z undoes"/>
            </StackPanel>

              <Button x:Name="PreviewCard" Height="170" Margin="0,0,0,16" Cursor="Hand" Click="Preview_Click" ToolTip="Open preview" Focusable="False" AutomationProperties.Name="Open preview">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" ClipToBounds="True">
                      <ContentPresenter/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
                <Grid>
                  <local:PathPreview x:Name="Thumbnail" ShowMarker="False" Margin="0,22,0,0"/>
                  <TextBlock Text="Route" Style="{StaticResource SectionTitle}" FontSize="12" Margin="10,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                  <TextBlock x:Name="ThumbnailInfo" Style="{StaticResource Hint}" Margin="0,9,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
              </Button>

            <!-- Script: what it can find on the screen, and what it wrote on the last test run -->
            <StackPanel x:Name="ScriptSide" Visibility="Collapsed" Margin="0,0,0,16">
              <TextBlock Text="Settings" Style="{StaticResource InspectorTitle}"/>
              <TextBlock x:Name="ScriptSettingsHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Mark a const in the script with // setting: and a name, like const SPEED = 80 // setting: How fast, to change it here."/>
              <StackPanel x:Name="ScriptSettingList" Margin="0,8,0,8"/>
              <TextBlock Text="Keys and buttons" Style="{StaticResource InspectorTitle}"/>
              <TextBlock x:Name="ScriptKeysHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Write on(&quot;1&quot;, &quot;Start&quot;, () =&gt; ...) to react to a key while the macro runs, or button(&quot;Reset&quot;, () =&gt; ...) for a button here. Help shows how."/>
              <StackPanel x:Name="ScriptKeyList" Margin="0,8,0,8"/>
              <TextBlock Text="Targets and grids" Style="{StaticResource InspectorTitle}"/>
              <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Things on the screen the script can use by name, like clickOn(&quot;Play&quot;). Click a name to put it in the script."/>
              <StackPanel x:Name="ScriptAssetList" Margin="0,8,0,0"/>
              <WrapPanel Margin="0,6,0,0">
                <Button Click="CapturePicture_Click" Padding="10,4" Margin="0,0,6,6" ToolTip="Drag around a button, an icon or some text on the screen. Esc cancels.">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconImage}" Style="{StaticResource Icon}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="New picture"/></StackPanel>
                </Button>
                <Button Click="PickColor_Click" Padding="10,4" Margin="0,0,6,6" ToolTip="Click a color on the screen. Esc cancels.">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconTarget}" Style="{StaticResource Icon}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="New color"/></StackPanel>
                </Button>
                <Button Click="MarkGrid_Click" Padding="10,4" Margin="0,0,6,6" ToolTip="Drag around a grid of numbers. Esc cancels.">
                  <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconGrid}" Style="{StaticResource Icon}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="New grid"/></StackPanel>
                </Button>
              </WrapPanel>
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Output" Style="{StaticResource InspectorTitle}" Margin="0"/>
                <Button x:Name="ClearOutputButton" Grid.Column="1" Content="Clear" Click="ClearOutput_Click" Padding="10,2" MinHeight="0"/>
              </Grid>
              <Border Style="{StaticResource MoreBox}" Margin="0,8,0,0" Padding="10,8">
                <TextBlock x:Name="ScriptOutput" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Text="Use Test run to play the script. What it writes with log() shows here."/>
              </Border>
            </StackPanel>

            <!-- Run settings: the common ones first, the rest under More options -->
            <StackPanel x:Name="TimingPanel">
              <TextBlock x:Name="SettingsTitle" Text="Run settings" Style="{StaticResource InspectorTitle}"/>
              <StackPanel x:Name="IntervalPanel">
                <TextBlock x:Name="IntervalLabel" Text="Every" Style="{StaticResource StackLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="IntervalTextBox" Width="80" AutomationProperties.Name="Interval"/>
                  <TextBlock Text="ms" Style="{StaticResource Unit}"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="RunsPanel">
                <TextBlock Text="Runs" Style="{StaticResource StackLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="RunsTextBox" Width="80" ToolTip="0 repeats until you stop it" AutomationProperties.Name="Runs"/>
                  <TextBlock Text="0 = until stopped" Style="{StaticResource Unit}"/>
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="ModeHintText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,12,0,0" Text="The input stays held until you stop this macro."/>

              <Border Style="{StaticResource MoreSection}">
              <StackPanel>
              <ToggleButton x:Name="MoreToggle" Style="{StaticResource Disclosure}" Content="More options" HorizontalAlignment="Left"/>
              <TextBlock x:Name="MoreSummary" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,2,0,0">
                <TextBlock.Visibility><Binding Path="IsChecked" ElementName="MoreToggle" Converter="{StaticResource HiddenWhenTrue}"/></TextBlock.Visibility>
              </TextBlock>
              <Border Style="{StaticResource MoreBox}" Visibility="{Binding IsChecked, ElementName=MoreToggle, Converter={StaticResource BoolToVisibility}}">
              <StackPanel x:Name="OptionsPanel">
                <TextBlock Text="Start after" Style="{StaticResource StackLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="StartDelayTextBox" Width="80" AutomationProperties.Name="Start after"/>
                  <TextBlock Text="ms" Style="{StaticResource Unit}"/>
                </StackPanel>
                <StackPanel x:Name="SettlePanel" ToolTip="Clicks and holds wait at least this long after the cursor arrives, so games see it there first. A Wait step before the click counts toward it. 0 clicks right away.">
                  <TextBlock Text="Click delay after moving" Style="{StaticResource StackLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SettleTextBox" Width="80" AutomationProperties.Name="Click delay after moving"/>
                    <TextBlock Text="ms" Style="{StaticResource Unit}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="WindowPanel" Margin="0,16,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="Target window" FontWeight="SemiBold"/>
                      <TextBlock x:Name="WindowText" Text="None · positions use screen coordinates" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="ClearWindowButton" Grid.Column="1" Content="Forget" Click="ClearWindow_Click" Padding="10,4" VerticalAlignment="Top" ToolTip="Forget the target window"/>
                  </Grid>
                  <CheckBox x:Name="ScaleBox" Content="Scale positions with the window" Margin="0,10,0,0" ToolTip="Off keeps the same pixel distance from the window corner."/>
                </StackPanel>
                <StackPanel x:Name="RunModePanel" Margin="0,16,0,0">
                  <TextBlock Text="Run mode" FontWeight="SemiBold"/>
                  <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="StandardModeRadio" GroupName="RunMode" Style="{StaticResource Segment}" Content="Standard" Checked="RunMode_Changed"/>
                      <RadioButton x:Name="BackgroundModeRadio" GroupName="RunMode" Style="{StaticResource Segment}" Content="Background" Checked="RunMode_Changed"/>
                      <RadioButton x:Name="SwitchModeRadio" GroupName="RunMode" Style="{StaticResource Segment}" Content="Quick switch" Checked="RunMode_Changed" ToolTip="For games that ignore Background, like Roblox"/>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="RunModeHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  <CheckBox x:Name="RestoreCursorBox" Content="Put my cursor back after each step" Margin="0,10,0,0" IsChecked="True"
                            ToolTip="When the macro hands your window back, your cursor returns to where you left it, so you can keep working. Off leaves it where the macro clicked."/>
                  <Button x:Name="TestButton" Content="Send a test input" Click="TestBackground_Click" Margin="0,10,0,0" HorizontalAlignment="Left" ToolTip="Send one input to the target window in this mode"/>
                </StackPanel>
              </StackPanel>
              </Border>
              </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,10,0,12">
      <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Top"/>
      <Grid Margin="2,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="RunButtons" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button x:Name="PreviewButton" Click="Preview_Click" Margin="0,0,6,0" Padding="11,4" ToolTip="Watch what happens and when, without sending any input">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlay}" Style="{StaticResource AccentIcon}" Width="9" Height="10" Margin="0,0,7,0"/><TextBlock Text="Preview"/></StackPanel>
          </Button>
          <Button x:Name="TestRunButton" Click="TestRun_Click" Padding="11,4" ToolTip="Play it once for real, with clicks and keys. Ctrl + Shift + F12 stops.">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconBolt}" Style="{StaticResource AccentIcon}" Width="9" Height="12" Margin="0,0,7,0"/><TextBlock Text="Test run"/></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Column="1" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="Cancel" Click="Cancel_Click" MinWidth="84" Margin="0,0,8,0" ToolTip="Discard changes (Esc)"/>
          <Button Content="Save macro" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="104"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
