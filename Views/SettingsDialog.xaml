<Window x:Class="Keyloom.Views.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings" Style="{StaticResource {x:Type Window}}" Width="430" Height="330" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource ShellBrush}" CornerRadius="8">
    <Grid>
      <Rectangle Fill="{StaticResource AuroraBrush}" IsHitTestVisible="False"/>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
          <Path Data="{StaticResource IconSettings}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
          <TextBlock Text="Settings" FontSize="12" Foreground="#2C4A60" VerticalAlignment="Center"/>
        </StackPanel>
        <Button IsCancel="True" Style="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cancel" AutomationProperties.Name="Close">
          <Path Data="{StaticResource IconClose}" Style="{StaticResource ChromeIcon}"/>
        </Button>
        <Grid Grid.Row="1" Margin="16,2,16,16" Style="{StaticResource ShellContent}">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Effect="{StaticResource CardShadow}">
            <StackPanel>
              <CheckBox x:Name="ExperimentalBox" Content="Show experimental features" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="26,6,0,0"
                         Text="Adds Background run mode to the macro editor. It sends clicks and keys straight to a chosen window, so your own mouse stays free. Many games, including ones that read raw mouse input, ignore it. Use Test background input before relying on it."/>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="26,8,0,0" FontSize="11"
                         Text="Macros that already use Background mode keep it when this is off."/>
              <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,14,0,10"/>
              <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
            <Button Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="84"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
