<Window x:Class="Keyloom.Views.MacroEditorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Edit macro" Style="{StaticResource {x:Type Window}}" Width="720" Height="570" MinWidth="650" MinHeight="440" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/></shell:WindowChrome.WindowChrome>
  <Border Background="{StaticResource PageBrush}" BorderBrush="#6F9AB5" BorderThickness="1" CornerRadius="7" Padding="7,0,7,7">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
          <Image Source="/Keyloom;component/Assets/keyloom.ico" Width="18" Height="18" Margin="0,0,7,0"/>
          <TextBlock x:Name="DialogTitleText" Text="Edit macro" FontSize="13" Foreground="#173B55" VerticalAlignment="Center"/>
        </StackPanel>
        <Button IsCancel="True" Style="{StaticResource CaptionButton}" Background="{StaticResource StopBrush}" Width="44" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cancel" AutomationProperties.Name="Cancel">
          <Path Data="{StaticResource IconClose}" Fill="#7E382D" Width="10" Height="10" Stretch="Uniform"/>
        </Button>
      </Grid>
      <Border Grid.Row="1" Background="#F5F9FC" BorderBrush="#7D9BB1" BorderThickness="1" CornerRadius="3">
        <Grid x:Name="MacroForm">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="48"/></Grid.RowDefinitions>
          <Border Background="{StaticResource GlassBrush}" BorderBrush="#B9CFDD" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="Name" Margin="0,0,0,5"/><TextBox x:Name="MacroNameTextBox" MaxLength="80"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Shortcut" Margin="0,0,0,5"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ShortcutTextBox" IsReadOnly="True" PreviewKeyDown="Shortcut_PreviewKeyDown" GotKeyboardFocus="Shortcut_Focused" LostKeyboardFocus="Shortcut_Unfocused" ToolTip="Click here and press a shortcut"/>
                  <Button Grid.Column="1" Content="Clear" Click="ClearShortcut_Click" Margin="5,0,0,0" Padding="8,4"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Macro type" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed">
                    <ComboBoxItem Content="Repeat input"/><ComboBoxItem Content="Hold input"/><ComboBoxItem Content="Sequence"/>
                  </ComboBox>
                  <Button Grid.Column="1" Click="Record_Click" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" ToolTip="Record mouse and keyboard input">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#A54334" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Record"/></StackPanel>
                  </Button>
                </Grid>
                <Border x:Name="TargetPanel" Background="White" BorderBrush="#BDCEDA" BorderThickness="1" CornerRadius="3" Padding="12">
                  <StackPanel>
                    <TextBlock Text="Input" Margin="0,0,0,6"/>
                    <ComboBox x:Name="TargetBox" SelectionChanged="Target_Changed" Margin="0,0,0,10"><ComboBoxItem Content="Mouse button"/><ComboBoxItem Content="Keyboard key or combination"/></ComboBox>
                    <ComboBox x:Name="MouseButtonBox"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="X1"/><ComboBoxItem Content="X2"/></ComboBox>
                    <StackPanel x:Name="KeyPanel" Visibility="Collapsed"><TextBox x:Name="TargetKeyTextBox"/><TextBlock Text="Space, F8, LeftCtrl, Ctrl+C" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="SequencePanel" Visibility="Collapsed">
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="Steps" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Delay" Click="InsertDelay_Click" ToolTip="Insert a delay after the selected step" Padding="8,4" Margin="0,0,7,0"/>
                      <Button Click="MoveUp_Click" ToolTip="Move step up" AutomationProperties.Name="Move step up" Width="28" Padding="6,4" Margin="0,0,4,0"><Path Data="{StaticResource IconArrowUp}" Fill="#3B637C" Width="12" Height="12" Stretch="Uniform"/></Button>
                      <Button Click="MoveDown_Click" ToolTip="Move step down" AutomationProperties.Name="Move step down" Width="28" Padding="6,4" Margin="0,0,4,0"><Path Data="{StaticResource IconArrowDown}" Fill="#3B637C" Width="12" Height="12" Stretch="Uniform"/></Button>
                      <Button Click="DuplicateStep_Click" ToolTip="Duplicate step" AutomationProperties.Name="Duplicate step" Width="28" Padding="6,4" Margin="0,0,4,0"><Path Data="M3 3H11V14H3Z M6 0H14V11" Stroke="#3B637C" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform"/></Button>
                      <Button Click="RemoveStep_Click" ToolTip="Remove step" AutomationProperties.Name="Remove step" Width="28" Padding="6,4"><Path Data="{StaticResource IconTrash}" Fill="#895D56" Width="12" Height="12" Stretch="Uniform"/></Button>
                    </StackPanel>
                  </Grid>
                  <ListBox x:Name="ActionsListBox" Height="125" SelectionChanged="Step_Selected" Margin="0,0,0,12">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Action" Margin="0,0,0,5"/><ComboBox x:Name="StepTypeBox" SelectionChanged="StepType_Changed" DisplayMemberPath="Label" SelectedValuePath="Kind"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Value" Margin="0,0,0,5"/><TextBox x:Name="StepValueTextBox" MaxHeight="70" VerticalScrollBarVisibility="Auto"/><ComboBox x:Name="StepMouseBox" Visibility="Collapsed"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="X1"/><ComboBoxItem Content="X2"/></ComboBox></StackPanel>
                  </Grid>
                  <TextBlock x:Name="StepHintText" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,9" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Add step" Click="AddStep_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
                    <Button x:Name="UpdateStepButton" Content="Update selected" Click="UpdateStep_Click" IsEnabled="False"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Background="#EAF3F9" BorderBrush="#BDCEDA" BorderThickness="1" CornerRadius="3" Padding="12" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="Execution" FontWeight="SemiBold" Foreground="#2C5874" Margin="0,0,0,14"/>
                  <TextBlock Text="Start delay (ms)" Margin="0,0,0,5"/>
                  <TextBox x:Name="StartDelayTextBox" Margin="0,0,0,14"/>
                  <StackPanel x:Name="IntervalPanel" Margin="0,0,0,14"><TextBlock x:Name="IntervalLabel" Text="Interval (ms)" Margin="0,0,0,5"/><TextBox x:Name="IntervalTextBox"/></StackPanel>
                  <StackPanel x:Name="RunsPanel"><TextBlock Text="Runs" Margin="0,0,0,5"/><TextBox x:Name="RunsTextBox"/><TextBlock Text="0 repeats until stopped" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                  <TextBlock x:Name="ModeHintText" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
          <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#A14E2E" TextWrapping="Wrap" Margin="14,0,14,8"/>
          <Border Grid.Row="3" Background="#EAF3F8" BorderBrush="#C7D9E4" BorderThickness="0,1,0,0" Padding="12,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Content="Cancel" IsCancel="True" Width="78" Margin="0,0,7,0"/>
              <Button Content="Save macro" Click="Save_Click" Style="{StaticResource PrimaryButton}" Width="94"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
