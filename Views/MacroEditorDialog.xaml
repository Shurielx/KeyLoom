<Window x:Class="Keyloom.Views.MacroEditorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit macro" Style="{StaticResource {x:Type Window}}" Width="680" Height="740" MinWidth="600" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="DialogTitleText" Text="Edit macro" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0"><TextBlock Text="Name" Margin="0,0,0,6"/><TextBox x:Name="MacroNameTextBox" MaxLength="80"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Shortcut" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="ShortcutTextBox" IsReadOnly="True" PreviewKeyDown="Shortcut_PreviewKeyDown" GotKeyboardFocus="Shortcut_Focused" LostKeyboardFocus="Shortcut_Unfocused" ToolTip="Click here and press a shortcut"/>
            <Button Grid.Column="1" Content="Clear" Click="ClearShortcut_Click" Margin="6,0,0,0" Padding="8,5"/>
          </Grid></StackPanel>
        </Grid>
        <TextBlock Text="Mode" Margin="0,0,0,6"/>
        <ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed" Margin="0,0,0,16">
          <ComboBoxItem Content="Repeat input"/><ComboBoxItem Content="Hold input"/><ComboBoxItem Content="Sequence"/>
        </ComboBox>
        <Border x:Name="TargetPanel" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Input" Margin="0,0,0,6"/>
            <ComboBox x:Name="TargetBox" SelectionChanged="Target_Changed" Margin="0,0,0,12"><ComboBoxItem Content="Mouse button"/><ComboBoxItem Content="Keyboard key or combination"/></ComboBox>
            <ComboBox x:Name="MouseButtonBox"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="X1"/><ComboBoxItem Content="X2"/></ComboBox>
            <StackPanel x:Name="KeyPanel" Visibility="Collapsed"><TextBox x:Name="TargetKeyTextBox"/><TextBlock Text="Examples: Space, F8, LeftCtrl, Ctrl+C" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
          </StackPanel>
        </Border>
        <StackPanel x:Name="SequencePanel" Visibility="Collapsed" Margin="0,0,0,16">
          <Grid Margin="0,0,0,8"><TextBlock Text="Steps" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Up" Click="MoveUp_Click" Padding="10,5" Margin="0,0,6,0"/><Button Content="Down" Click="MoveDown_Click" Padding="10,5" Margin="0,0,6,0"/><Button Content="Remove" Click="RemoveStep_Click" Padding="10,5"/></StackPanel>
          </Grid>
          <ListBox x:Name="ActionsListBox" Height="116" SelectionChanged="Step_Selected" Margin="0,0,0,12">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Action" Margin="0,0,0,6"/><ComboBox x:Name="StepTypeBox" SelectionChanged="StepType_Changed" DisplayMemberPath="Label" SelectedValuePath="Kind"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Value" Margin="0,0,0,6"/><TextBox x:Name="StepValueTextBox" MaxHeight="90" VerticalScrollBarVisibility="Auto"/><ComboBox x:Name="StepMouseBox" Visibility="Collapsed"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="X1"/><ComboBoxItem Content="X2"/></ComboBox></StackPanel>
          </Grid>
          <TextBlock x:Name="StepHintText" Style="{StaticResource Muted}" Margin="0,6,0,10" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal"><Button Content="Add step" Click="AddStep_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="UpdateStepButton" Content="Update selected" Click="UpdateStep_Click" IsEnabled="False"/></StackPanel>
        </StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="Start delay (ms)" Margin="0,0,0,6"/><TextBox x:Name="StartDelayTextBox"/></StackPanel>
          <StackPanel x:Name="IntervalPanel" Grid.Column="1" Margin="0,0,12,0"><TextBlock x:Name="IntervalLabel" Text="Interval (ms)" Margin="0,0,0,6"/><TextBox x:Name="IntervalTextBox"/></StackPanel>
          <StackPanel x:Name="RunsPanel" Grid.Column="2"><TextBlock Text="Runs (0 = loop)" Margin="0,0,0,6"/><TextBox x:Name="RunsTextBox"/></StackPanel>
        </Grid>
        <TextBlock x:Name="ModeHintText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="Save macro" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
  </Grid>
</Window>
