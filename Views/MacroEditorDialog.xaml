<Window x:Class="Keyloom.Views.MacroEditorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Edit macro" Style="{StaticResource {x:Type Window}}" Width="720" Height="570" MinWidth="650" MinHeight="440" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource ShellBrush}" CornerRadius="8">
    <Grid>
      <Rectangle Fill="{StaticResource AuroraBrush}" IsHitTestVisible="False"/>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
            <Image Source="/Keyloom;component/Assets/keyloom.ico" Width="18" Height="18" Margin="0,0,9,0"/>
            <TextBlock x:Name="DialogTitleText" Text="Edit macro" FontSize="12" Foreground="#2C4A60" VerticalAlignment="Center"/>
          </StackPanel>
          <Button IsCancel="True" Style="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cancel" AutomationProperties.Name="Cancel">
            <Path Data="{StaticResource IconClose}" Style="{StaticResource ChromeIcon}"/>
          </Button>
        </Grid>
        <Grid x:Name="MacroForm" Grid.Row="1" Style="{StaticResource ShellContent}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="56"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="16,2,16,0" Padding="14,12" Effect="{StaticResource CardShadow}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MacroNameTextBox" MaxLength="80"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Shortcut" Style="{StaticResource FieldLabel}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ShortcutTextBox" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="Shortcut_PreviewKeyDown" GotKeyboardFocus="Shortcut_Focused" LostKeyboardFocus="Shortcut_Unfocused" ToolTip="Click here and press a shortcut"/>
                  <Button Grid.Column="1" Content="Clear" Click="ClearShortcut_Click" Margin="6,0,0,0" Padding="10,4"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16,12,16,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Macro type" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed">
                    <ComboBoxItem Content="Repeat input"/><ComboBoxItem Content="Hold input"/><ComboBoxItem Content="Sequence"/>
                  </ComboBox>
                  <Button Grid.Column="1" Click="Record_Click" Margin="8,0,0,0" ToolTip="Record mouse and keyboard input">
                    <StackPanel Orientation="Horizontal"><Grid Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse Fill="#33D2412F"/><Ellipse Width="6" Height="6" Fill="#D2412F"/></Grid><TextBlock Text="Record"/></StackPanel>
                  </Button>
                </Grid>
                <Border x:Name="TargetPanel" Style="{StaticResource Card}" Padding="14,12">
                  <StackPanel>
                    <TextBlock Text="Input" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TargetBox" SelectionChanged="Target_Changed" Margin="0,0,0,10"><ComboBoxItem Content="Mouse button"/><ComboBoxItem Content="Keyboard key or combination"/></ComboBox>
                    <ComboBox x:Name="MouseButtonBox"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="X1"/><ComboBoxItem Content="X2"/></ComboBox>
                    <StackPanel x:Name="KeyPanel" Visibility="Collapsed"><TextBox x:Name="TargetKeyTextBox"/><TextBlock Text="Space, F8, LeftCtrl, Ctrl+C" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="SequencePanel" Visibility="Collapsed">
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="Steps" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Delay" Click="InsertDelay_Click" ToolTip="Insert a delay after the selected step" Padding="10,3" MinHeight="28" Margin="0,0,6,0"/>
                      <Button Click="MoveUp_Click" Style="{StaticResource IconButton}" ToolTip="Move step up" AutomationProperties.Name="Move step up" Width="28" Height="28" Margin="0,0,2,0"><Path Data="{StaticResource IconArrowUp}" Fill="#3B637C" Width="12" Height="12" Stretch="Uniform"/></Button>
                      <Button Click="MoveDown_Click" Style="{StaticResource IconButton}" ToolTip="Move step down" AutomationProperties.Name="Move step down" Width="28" Height="28" Margin="0,0,2,0"><Path Data="{StaticResource IconArrowDown}" Fill="#3B637C" Width="12" Height="12" Stretch="Uniform"/></Button>
                      <Button Click="DuplicateStep_Click" Style="{StaticResource IconButton}" ToolTip="Duplicate step" AutomationProperties.Name="Duplicate step" Width="28" Height="28" Margin="0,0,2,0"><Path Data="M3 3H11V14H3Z M6 0H14V11" Stroke="#3B637C" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform"/></Button>
                      <Button Click="RemoveStep_Click" Style="{StaticResource IconButton}" ToolTip="Remove step" AutomationProperties.Name="Remove step" Width="28" Height="28"><Path Data="{StaticResource IconTrash}" Fill="#A2564A" Width="12" Height="12" Stretch="Uniform"/></Button>
                    </StackPanel>
                  </Grid>
                  <ListBox x:Name="ActionsListBox" Height="135" SelectionChanged="Step_Selected" Margin="0,0,0,12">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Action" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="StepTypeBox" SelectionChanged="StepType_Changed" DisplayMemberPath="Label" SelectedValuePath="Kind"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Value" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StepValueTextBox" MaxHeight="70" VerticalScrollBarVisibility="Auto"/><ComboBox x:Name="StepMouseBox" Visibility="Collapsed"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="X1"/><ComboBoxItem Content="X2"/></ComboBox></StackPanel>
                  </Grid>
                  <TextBlock x:Name="StepHintText" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,10" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Click="AddStep_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlus}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Add step"/></StackPanel>
                    </Button>
                    <Button x:Name="UpdateStepButton" Content="Update selected" Click="UpdateStep_Click" IsEnabled="False"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}" Padding="14" VerticalAlignment="Top">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Path Data="{StaticResource IconClock}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Execution" Style="{StaticResource SectionTitle}"/>
                  </StackPanel>
                  <TextBlock Text="Start delay (ms)" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="StartDelayTextBox" Margin="0,0,0,14"/>
                  <StackPanel x:Name="IntervalPanel" Margin="0,0,0,14"><TextBlock x:Name="IntervalLabel" Text="Interval (ms)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="IntervalTextBox"/></StackPanel>
                  <StackPanel x:Name="RunsPanel"><TextBlock Text="Runs" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RunsTextBox"/><TextBlock Text="0 repeats until stopped" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                  <TextBlock x:Name="ModeHintText" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
          <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Margin="18,0,18,8"/>
          <Grid Grid.Row="3" Margin="16,0">
            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
              <Button Content="Save macro" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="104"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
