<UserControl x:Class="Keyloom.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Keyloom.Views"
             Foreground="{DynamicResource InkBrush}">
  <UserControl.Resources>
    <Style x:Key="ThemeChoice" TargetType="RadioButton" BasedOn="{StaticResource ChoiceCard}">
      <Setter Property="GroupName" Value="Theme"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,12"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-4,0,-14,0" Padding="4,0,14,0">
    <StackPanel Margin="0,0,0,16" MaxWidth="640" HorizontalAlignment="Center">
      <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="2,0,0,8"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Theme" FontWeight="SemiBold"/>
          <TextBlock Text="System follows the Windows app mode and switches with it." Style="{StaticResource Hint}" Margin="0,2,0,12"/>
          <UniformGrid Columns="3">
            <RadioButton x:Name="SystemThemeRadio" Style="{StaticResource ThemeChoice}" Margin="0,0,5,0" Checked="Theme_Checked">
              <StackPanel><Path Data="{StaticResource IconMonitor}" Style="{StaticResource AccentIcon}" Width="20" Height="20"/><TextBlock Text="System" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="LightThemeRadio" Style="{StaticResource ThemeChoice}" Margin="5,0" Checked="Theme_Checked">
              <StackPanel><Path Data="{StaticResource IconSun}" Style="{StaticResource AccentIcon}" Width="20" Height="20"/><TextBlock Text="Light" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="DarkThemeRadio" Style="{StaticResource ThemeChoice}" Margin="5,0,0,0" Checked="Theme_Checked">
              <StackPanel><Path Data="{StaticResource IconMoon}" Style="{StaticResource AccentIcon}" Width="18" Height="18" Margin="0,1"/><TextBlock Text="Dark" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/></StackPanel>
            </RadioButton>
          </UniformGrid>
          <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,14"/>
          <CheckBox x:Name="SoundBox" Style="{StaticResource Switch}" Checked="Sound_Changed" Unchecked="Sound_Changed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Top"><Path Data="{StaticResource IconSound}" Style="{StaticResource AccentIcon}"/></Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Click sounds" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="A quiet tap when you click buttons and switches in Keyloom. Macros never make it."/>
              </StackPanel>
            </Grid>
          </CheckBox>
        </StackPanel>
      </Border>

      <TextBlock Text="Features" Style="{StaticResource SectionTitle}" Margin="2,18,0,8"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
        <CheckBox x:Name="ExperimentalBox" Style="{StaticResource Switch}" Checked="Experimental_Changed" Unchecked="Experimental_Changed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Top"><Path Data="{StaticResource IconFlask}" Style="{StaticResource AccentIcon}"/></Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Experimental features" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"
                         Text="Adds run modes to the editor that let you keep using your PC. Background sends clicks and keys straight to a chosen window, but many games ignore it. Quick switch works with those games, Roblox included, by bringing the window forward for a moment for each input."/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Macros that already use one of these modes keep it when this is off."/>
            </StackPanel>
          </Grid>
        </CheckBox>
        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,14"/>
        <CheckBox x:Name="BuilderBox" Style="{StaticResource Switch}" Checked="Builder_Changed" Unchecked="Builder_Changed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Top"><Path Data="{StaticResource IconCursorMove}" Style="{StaticResource AccentIcon}"/></Border>
            <StackPanel Grid.Column="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Macro builder" FontWeight="SemiBold"/>
                <Border Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Experimental" FontSize="10.5"/></Border>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"
                         Text="Adds Build on screen to sequences: place points where the cursor goes, and set clicks, holds, keys and waits right on the screen. Still rough around the edges."/>
            </StackPanel>
          </Grid>
        </CheckBox>
        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,14"/>
        <CheckBox x:Name="ScriptsBox" Style="{StaticResource Switch}" Checked="Scripts_Changed" Unchecked="Scripts_Changed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Top"><Path Data="{StaticResource IconCode}" Style="{StaticResource AccentIcon}"/></Border>
            <StackPanel Grid.Column="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Scripts" FontWeight="SemiBold"/>
                <Border Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Experimental" FontSize="10.5"/></Border>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"
                         Text="Adds Script next to Sequence: write what a macro does in JavaScript, with simple functions like press(&quot;E&quot;), clickOn(&quot;Play&quot;) and wait(500). For things steps cannot do, like counting or deciding by a number."/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Script macros you already have keep working when this is off."/>
            </StackPanel>
          </Grid>
        </CheckBox>
        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,14"/>
        <CheckBox x:Name="AiBox" Style="{StaticResource Switch}" Checked="Ai_Changed" Unchecked="Ai_Changed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Top"><Path Data="{StaticResource IconAi}" Style="{StaticResource AccentIcon}"/></Border>
            <StackPanel Grid.Column="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="AI" FontWeight="SemiBold"/>
                <Border Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Experimental" FontSize="10.5"/></Border>
              </StackPanel>
              <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"
                         Text="Lets a running macro ask an AI about the screen: an If that plays when the AI says yes, and ask() in scripts. The AI only looks and answers. It never clicks, types or changes your macros."/>
            </StackPanel>
          </Grid>
        </CheckBox>
        <!-- Which AI, shown while AI is on -->
        <StackPanel x:Name="AiPanel" Margin="46,14,0,0" Visibility="Collapsed">
          <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="OllamaRadio" GroupName="AiProvider" Style="{StaticResource Segment}" Content="Ollama, on this PC" Checked="AiProvider_Changed"/>
              <RadioButton x:Name="OpenRouterRadio" GroupName="AiProvider" Style="{StaticResource Segment}" Content="OpenRouter, online" Checked="AiProvider_Changed"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="AiProviderHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <StackPanel x:Name="OllamaPanel">
            <TextBlock Text="Ollama address" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <TextBox x:Name="OllamaUrlTextBox" LostKeyboardFocus="AiField_Changed" AutomationProperties.Name="Ollama address"/>
          </StackPanel>
          <StackPanel x:Name="OpenRouterPanel">
            <TextBlock Text="OpenRouter key" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <PasswordBox x:Name="OpenRouterKeyBox" MinHeight="32" Padding="8,6" VerticalContentAlignment="Center" LostKeyboardFocus="AiField_Changed" AutomationProperties.Name="OpenRouter key"
                         Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" CaretBrush="{DynamicResource InkBrush}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Make one at openrouter.ai, under Keys. Keyloom keeps it encrypted for your Windows account."/>
          </StackPanel>
          <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="AiModelBox" IsEditable="True" LostKeyboardFocus="AiField_Changed" SelectionChanged="AiModel_Picked" AutomationProperties.Name="AI model"/>
            <Button Grid.Column="1" Content="Load models" Click="LoadModels_Click" Padding="10,4" Margin="8,0,0,0" ToolTip="Lists the models that can look at pictures"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="AiTestButton" Click="AiTest_Click" Padding="10,4">
              <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconAi}" Style="{StaticResource AccentIcon}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="Try it"/></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock x:Name="AiStatusText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="While a macro runs" Style="{StaticResource SectionTitle}" Margin="2,18,0,8"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox x:Name="IndicatorBox" Style="{StaticResource Switch}" Checked="Indicator_Changed" Unchecked="Indicator_Changed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Top"><Path Data="{StaticResource IconPlay}" Style="{StaticResource AccentIcon}" Width="12" Height="12"/></Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Show a running card on screen" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Stays up while a macro runs, with the time and how to stop it. Clicks pass through it. Off shows it only for a moment."/>
              </StackPanel>
            </Grid>
          </CheckBox>
          <StackPanel x:Name="PlacePanel" Orientation="Horizontal" Margin="46,12,0,0">
            <TextBlock Text="Place" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border Style="{StaticResource SegmentBar}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PlaceTopRadio" GroupName="Place" Style="{StaticResource Segment}" Content="Top" Checked="Place_Checked"/>
                <RadioButton x:Name="PlaceTopRightRadio" GroupName="Place" Style="{StaticResource Segment}" Content="Top right" Checked="Place_Checked"/>
                <RadioButton x:Name="PlaceBottomRightRadio" GroupName="Place" Style="{StaticResource Segment}" Content="Bottom right" Checked="Place_Checked"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid Margin="2,18,0,8">
        <TextBlock Text="Usage" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
        <Button x:Name="ResetUsageButton" Click="ResetUsage_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,-6,-4,-6" ToolTip="Start counting again">
          <TextBlock Text="Reset" Foreground="{DynamicResource MutedBrush}"/>
        </Button>
      </Grid>
      <Border Style="{StaticResource Card}" Padding="0">
        <StackPanel>
          <!-- Totals -->
          <Grid Margin="16,14,16,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="StartsText" Text="0" Style="{StaticResource PageTitle}" FontSize="20" Typography.NumeralAlignment="Tabular"/>
              <TextBlock Text="macros started" Style="{StaticResource Muted}" Margin="0,1,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="RunTimeText" Text="0 s" Style="{StaticResource PageTitle}" FontSize="20"/>
              <TextBlock Text="running in total" Style="{StaticResource Muted}" Margin="0,1,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="TopText" Text="None yet" Style="{StaticResource PageTitle}" FontSize="20" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="used the most" Style="{StaticResource Muted}" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
          <Rectangle Height="1" Fill="{DynamicResource DividerBrush}"/>
          <!-- Per macro, longest running first; the bar shows its share of the total time -->
          <ItemsControl x:Name="UsageList" Margin="0,4,0,6">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="16,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                  <Border CornerRadius="6" Background="{DynamicResource AccentTileBrush}"/>
                  <local:MacroIcon Kind="{Binding Profile.IconKind}" Glyph="{Binding Profile.IconGlyph}" Image="{Binding Profile.IconImage}" Behavior="{Binding Profile.Behavior}" Target="{Binding Profile.TargetType}" Foreground="{DynamicResource AccentBrush}" SymbolSize="11"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                  <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <Grid Height="4" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Share}"/><ColumnDefinition Width="{Binding Rest}"/></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource DividerBrush}"/>
                    <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity=".75"/>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="150">
                  <TextBlock Text="{Binding Totals}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                  <TextBlock Text="{Binding Last}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="SinceText" Style="{StaticResource Hint}" Margin="16,0,16,12"/>
        </StackPanel>
      </Border>

      <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="2,18,0,8"/>
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="/Keyloom;component/Assets/keyloom.ico" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
            <TextBlock Text="Macros and settings are stored on this PC in %APPDATA%\Keyloom." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
          </StackPanel>
          <Button Grid.Column="2" Click="OpenFolder_Click" VerticalAlignment="Center" Padding="11,4">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolder}" Style="{StaticResource Icon}" Width="13" Height="13" Margin="0,0,7,0"/><TextBlock Text="Open folder"/></StackPanel>
          </Button>
        </Grid>
      </Border>
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Margin="2,10,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
