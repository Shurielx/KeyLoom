<Window x:Class="Keyloom.Views.RecordingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Keyloom recording" Style="{StaticResource {x:Type Window}}" Width="430" Height="76" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource ShellBrush}" CornerRadius="8" Padding="14,0,12,0">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0" MouseLeftButtonDown="Drag_MouseDown" Background="Transparent">
        <Ellipse x:Name="RecordingHalo" Fill="#D2412F" Opacity=".25" RenderTransformOrigin=".5,.5">
          <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale"/></Ellipse.RenderTransform>
          <Ellipse.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX" From=".45" To="1" Duration="0:0:1.1" EasingFunction="{StaticResource EaseOut}"/>
                <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY" From=".45" To="1" Duration="0:0:1.1" EasingFunction="{StaticResource EaseOut}"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From=".5" To="0" Duration="0:0:1.1"/>
              </Storyboard></BeginStoryboard>
            </EventTrigger>
          </Ellipse.Triggers>
        </Ellipse>
        <Ellipse x:Name="RecordingDot" Width="9" Height="9" Fill="#D2412F"/>
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" MouseLeftButtonDown="Drag_MouseDown" Background="Transparent">
        <TextBlock x:Name="StateText" Text="Starting in 3..." FontWeight="SemiBold" FontSize="13"/>
        <TextBlock x:Name="DetailsText" Text="Switch to your target window" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" IsEnabled="False" MinWidth="72" Margin="0,0,6,0"/>
        <Button x:Name="StopButton" Content="Cancel" Click="Stop_Click" Style="{StaticResource DangerButton}" MinWidth="72"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
