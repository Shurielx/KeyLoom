<UserControl x:Class="Keyloom.Views.HelpView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource InkBrush}">
  <UserControl.Resources>
    <Style x:Key="Body" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/><Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/></Style>
    <Style x:Key="Number" TargetType="Border">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource BlueButtonBrush}"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="TextElement.Foreground" Value="White"/><Setter Property="TextElement.FontWeight" Value="Bold"/><Setter Property="TextElement.FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="TopicHeader" TargetType="StackPanel"><Setter Property="Orientation" Value="Horizontal"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="TopicIcon" TargetType="Border" BasedOn="{StaticResource IconTile}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
    <Style x:Key="Bullet" TargetType="Ellipse"><Setter Property="Width" Value="5"/><Setter Property="Height" Value="5"/><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
  </UserControl.Resources>
  <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-4,0,-14,0" Padding="4,0,14,0">
    <StackPanel Margin="0,0,0,16">
      <!-- Get started -->
      <Border Style="{StaticResource Card}" Effect="{DynamicResource CardShadow}" Padding="16,14">
        <StackPanel>
          <TextBlock Text="Get started" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,12"/>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Number}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center"><Run Text="Click"/><Run Text=" New macro" FontWeight="SemiBold"/><Run Text=", give it a name and, if you like, an icon."/></TextBlock>
          </Grid>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Number}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center"><Run Text="Choose what it does:"/><Run Text=" Repeat" FontWeight="SemiBold"/><Run Text=","/><Run Text=" Hold" FontWeight="SemiBold"/><Run Text=" or"/><Run Text=" Sequence" FontWeight="SemiBold"/><Run Text=", then set the input."/></TextBlock>
          </Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Number}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center" Text="Set a shortcut and save. Press the shortcut in any app to start; press it again to stop."/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Macro types -->
      <UniformGrid Columns="3" Margin="0,12,0,0">
        <Border Style="{StaticResource Card}" Margin="0,0,6,0">
          <StackPanel>
            <StackPanel Style="{StaticResource TopicHeader}"><Border Style="{StaticResource TopicIcon}"><Path Data="{StaticResource IconRepeat}" Style="{StaticResource AccentIcon}" Width="13" Height="13"/></Border><TextBlock Text="Repeat" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Style="{StaticResource Body}" Text="Clicks or presses one input at a fixed interval, as many times as you set or until you stop it."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0">
          <StackPanel>
            <StackPanel Style="{StaticResource TopicHeader}"><Border Style="{StaticResource TopicIcon}"><Path Data="{StaticResource IconHold}" Style="{StaticResource AccentIcon}" Width="13" Height="13"/></Border><TextBlock Text="Hold" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Style="{StaticResource Body}" Text="Keeps one key or mouse button held down until you stop the macro."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0,0,0">
          <StackPanel>
            <StackPanel Style="{StaticResource TopicHeader}"><Border Style="{StaticResource TopicIcon}"><Path Data="{StaticResource IconBolt}" Style="{StaticResource AccentIcon}" Width="13" Height="13"/></Border><TextBlock Text="Sequence" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Style="{StaticResource Body}" Text="Plays a list of steps: clicks, keys, waits, pointer moves, scrolling and typed text."/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Record and pick -->
      <UniformGrid Columns="2" Margin="0,12,0,0">
        <Border Style="{StaticResource Card}" Margin="0,0,6,0">
          <StackPanel>
            <StackPanel Style="{StaticResource TopicHeader}"><Border Style="{StaticResource TopicIcon}"><Grid Width="12" Height="12"><Ellipse Fill="{DynamicResource RecordHaloBrush}"/><Ellipse Width="7" Height="7" Fill="{DynamicResource RecordBrush}"/></Grid></Border><TextBlock Text="Record and edit" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Style="{StaticResource Body}" Text="Record captures your mouse and keyboard after a 3-second countdown; F8 stops it. Select any step to change it; edits apply as you type. Preview plays the route without moving your pointer."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0,0,0">
          <StackPanel>
            <StackPanel Style="{StaticResource TopicHeader}"><Border Style="{StaticResource TopicIcon}"><Path Data="{StaticResource IconTarget}" Style="{StaticResource AccentIcon}" Width="13" Height="13"/></Border><TextBlock Text="Pick a point" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Style="{StaticResource Body}" Text="Click once inside another window. Keyloom remembers that window, so clicks follow it when it moves. Esc or right-click cancels."/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Shortcuts -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
        <StackPanel>
          <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl"/></Border><Border Style="{StaticResource Keycap}"><TextBlock Text="Shift"/></Border><Border Style="{StaticResource Keycap}"><TextBlock Text="F12"/></Border></StackPanel>
            <TextBlock Grid.Column="1" Text="Stop all macros" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal"><Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl"/></Border><Border Style="{StaticResource Keycap}"><TextBlock Text="Shift"/></Border><Border Style="{StaticResource Keycap}"><TextBlock Text="I"/></Border></StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Show or hide Keyloom" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal"><Border Style="{StaticResource Keycap}"><TextBlock Text="F8"/></Border></StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Stop recording" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal"><Border Style="{StaticResource Keycap}"><TextBlock Text="Esc"/></Border></StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Cancel picking, close a dialog or leave the editor" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal"><Border Style="{StaticResource Keycap}"><TextBlock Text="Delete"/></Border><Border Style="{StaticResource Keycap}" Margin="6,0,4,0"><TextBlock Text="Alt"/></Border><Border Style="{StaticResource Keycap}"><TextBlock Text="&#x2191; &#x2193;"/></Border></StackPanel>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Remove or move the selected step" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Good to know -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
        <StackPanel>
          <StackPanel Style="{StaticResource TopicHeader}"><Border Style="{StaticResource TopicIcon}"><Path Data="{StaticResource IconInfo}" Style="{StaticResource AccentIcon}" Width="14" Height="14"/></Border><TextBlock Text="Good to know" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></StackPanel>
          <BulletDecorator Margin="0,0,0,6"><BulletDecorator.Bullet><Ellipse Style="{StaticResource Bullet}"/></BulletDecorator.Bullet><TextBlock Style="{StaticResource Body}" Text="One macro runs at a time. Shortcuts pause while you edit a macro."/></BulletDecorator>
          <BulletDecorator Margin="0,0,0,6"><BulletDecorator.Bullet><Ellipse Style="{StaticResource Bullet}"/></BulletDecorator.Bullet><TextBlock Style="{StaticResource Body}" Text="Closing the window keeps Keyloom in the tray. Use the tray menu to exit."/></BulletDecorator>
          <BulletDecorator Margin="0,0,0,6"><BulletDecorator.Bullet><Ellipse Style="{StaticResource Bullet}"/></BulletDecorator.Bullet><TextBlock Style="{StaticResource Body}" Text="Any Windows keyboard or mouse works. No special hardware or administrator rights are needed."/></BulletDecorator>
          <BulletDecorator><BulletDecorator.Bullet><Ellipse Style="{StaticResource Bullet}"/></BulletDecorator.Bullet><TextBlock Style="{StaticResource Body}" Text="Some apps and games ignore synthetic input, and game rules may not allow automation."/></BulletDecorator>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
