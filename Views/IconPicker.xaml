<UserControl x:Class="Keyloom.Views.IconPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Keyloom.Views"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <UserControl.Resources>
    <Style x:Key="IconChoice" TargetType="RadioButton" BasedOn="{StaticResource ChoiceCard}">
      <Setter Property="Width" Value="52"/><Setter Property="Height" Value="52"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,6,6"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>
  <!-- Shown in a popup: margin leaves room for the shadow, which sits behind the content so text stays sharp. -->
  <Grid Margin="10,0,10,16" Width="316">
    <Border Style="{StaticResource PopupShadowLayer}" CornerRadius="10"/>
    <Border Style="{StaticResource PopupSurface}" CornerRadius="10" Padding="12" TextElement.Foreground="{DynamicResource InkBrush}">
      <StackPanel>
        <TextBlock Text="Icon" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
        <WrapPanel>
          <RadioButton x:Name="AutoIconRadio" Style="{StaticResource IconChoice}" Checked="Choice_Checked" ToolTip="Automatic: follows the macro type">
            <Grid><local:MacroIcon x:Name="AutoIconPreview" SymbolSize="17" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="AUTO" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-14"/></Grid>
          </RadioButton>
          <RadioButton x:Name="MouseIconRadio" Style="{StaticResource IconChoice}" Checked="Choice_Checked" ToolTip="Mouse"><Path Data="{StaticResource IconMouse}" Style="{StaticResource AccentIcon}" Width="18" Height="18"/></RadioButton>
          <RadioButton x:Name="KeyboardIconRadio" Style="{StaticResource IconChoice}" Checked="Choice_Checked" ToolTip="Keyboard"><Path Data="{StaticResource IconKeyboard}" Style="{StaticResource AccentIcon}" Width="20" Height="20"/></RadioButton>
          <RadioButton x:Name="CursorIconRadio" Style="{StaticResource IconChoice}" Checked="Choice_Checked" ToolTip="Moving pointer"><Path Data="{StaticResource IconCursorMove}" Style="{StaticResource AccentIcon}" Width="20" Height="20"/></RadioButton>
          <RadioButton x:Name="ImageIconRadio" Style="{StaticResource IconChoice}" Checked="Choice_Checked" ToolTip="Your picture" Visibility="Collapsed">
            <local:MacroIcon x:Name="ImageIconPreview" Kind="Image" Width="44" Height="44"/>
          </RadioButton>
        </WrapPanel>
        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,6,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Letter or number" FontWeight="SemiBold"/>
            <TextBlock Text="Up to two characters, like K, 2 or P1" Style="{StaticResource Hint}" Margin="0,2,8,0"/>
          </StackPanel>
          <TextBox x:Name="GlyphTextBox" Grid.Column="1" MaxLength="2" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Center" TextChanged="Glyph_Changed" AutomationProperties.Name="Icon letter or number"/>
        </Grid>
        <Button Click="Upload_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconUpload}" Style="{StaticResource Icon}" Width="13" Height="13" Margin="0,0,8,0"/><TextBlock Text="Use your own picture..."/></StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
