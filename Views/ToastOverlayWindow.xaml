<Window x:Class="Keyloom.Views.ToastOverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyloom notification" Style="{StaticResource {x:Type Window}}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight" Focusable="False">
  <!-- A calm card: no blinking, just what runs, for how long and how to stop it. Clicks pass through it. -->
  <Grid x:Name="ToastCard" Margin="16,8,16,22" MaxWidth="420" RenderTransformOrigin=".5,0">
    <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="ToastScale"/><TranslateTransform x:Name="ToastShift"/></TransformGroup></Grid.RenderTransform>
    <Border Style="{StaticResource PopupShadowLayer}" CornerRadius="12"/>
    <Border Style="{StaticResource PopupSurface}" CornerRadius="12" Padding="12,9,16,9">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ToastBadge" Width="28" Height="28" CornerRadius="8" Background="#212E9E6B" Margin="0,0,11,0" VerticalAlignment="Center">
          <Path x:Name="ToastIcon" Data="{StaticResource IconPlay}" Fill="#2E9E6B" Stretch="Uniform" Width="10" Height="11"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock TextTrimming="CharacterEllipsis" MaxWidth="320">
            <Run x:Name="ToastTitle" Text="Running" FontWeight="SemiBold"/><Run x:Name="ToastName" Foreground="{DynamicResource InkSoftBrush}"/>
          </TextBlock>
          <TextBlock x:Name="ToastSubtext" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
