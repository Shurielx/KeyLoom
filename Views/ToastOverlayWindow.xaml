<Window x:Class="Keyloom.Views.ToastOverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyloom notification" Style="{StaticResource {x:Type Window}}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight" Focusable="False">
  <Border x:Name="ToastCard" Margin="16,8,16,22" Background="#F2FBFDFF" BorderBrush="#330F3550" BorderThickness="1" CornerRadius="12" Padding="14,10,18,10" MaxWidth="400" Effect="{StaticResource PopupShadow}" RenderTransformOrigin=".5,0">
    <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="ToastScale"/><TranslateTransform x:Name="ToastShift"/></TransformGroup></Border.RenderTransform>
    <StackPanel Orientation="Horizontal">
      <Border x:Name="ToastBadge" Width="30" Height="30" CornerRadius="15" Background="#212E9E6B" Margin="0,0,11,0" VerticalAlignment="Center">
        <Path x:Name="ToastIcon" Data="{StaticResource IconBolt}" Fill="#2E9E6B" Stretch="Uniform" Width="11" Height="15"/>
      </Border>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ToastTitle" Text="Macro running" FontSize="12.5" FontWeight="SemiBold"/><TextBlock x:Name="ToastSubtext" Foreground="{StaticResource MutedBrush}" FontSize="11" MaxWidth="300" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel>
    </StackPanel>
  </Border>
</Window>
