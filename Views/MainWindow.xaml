<Window x:Class="Keyloom.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Keyloom" Style="{StaticResource {x:Type Window}}" Width="720" Height="440" MinWidth="620" MinHeight="330" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/></shell:WindowChrome.WindowChrome>
  <Border Background="{StaticResource PageBrush}" BorderBrush="#6F9AB5" BorderThickness="1" CornerRadius="7" Padding="7,0,7,7">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
          <Image Source="/Keyloom;component/Assets/keyloom.ico" Width="20" Height="20" Margin="0,0,7,0"/>
          <TextBlock Text="Keyloom" FontSize="13" Foreground="#173B55" VerticalAlignment="Center"><TextBlock.Effect><DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="5" Opacity=".9"/></TextBlock.Effect></TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Click="Minimize_Click" Style="{StaticResource CaptionButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="{StaticResource IconMinimize}" Fill="#264F6B" Width="10" Height="10" Stretch="Uniform"/></Button>
          <Button Click="Maximize_Click" Style="{StaticResource CaptionButton}" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" Margin="1,0,0,0"><Rectangle Width="9" Height="8" Stroke="#264F6B" StrokeThickness="1.3"/></Button>
          <Button Click="Hide_Click" Style="{StaticResource CaptionButton}" Background="{StaticResource StopBrush}" Width="44" ToolTip="Close to tray" AutomationProperties.Name="Close to tray" Margin="1,0,0,0"><Path Data="{StaticResource IconClose}" Fill="#7E382D" Width="10" Height="10" Stretch="Uniform"/></Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#F8FBFD" BorderBrush="#7D9BB1" BorderThickness="1" CornerRadius="3">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/></Grid.RowDefinitions>
          <Border Background="{StaticResource GlassBrush}" BorderBrush="#A8C3D6" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="New macro" Click="Add_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="Stop all" Click="Stop_Click"/>
              </StackPanel>
              <Button Content="Help" Click="Help_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,4"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="12,0,12,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="142"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
              <TextBlock Text="Macro" Foreground="#526B7C"/>
              <TextBlock Grid.Column="1" Text="Shortcut" Foreground="#526B7C"/>
            </Grid>
            <Border Grid.Row="1" Background="White" BorderBrush="#BACBD6" BorderThickness="1" CornerRadius="2">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                  <TextBlock x:Name="EmptyText" Text="Create your first macro with New macro." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,32"/>
                  <ItemsControl x:Name="ProfilesItemsControl">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border x:Name="MacroRow" Background="White" BorderBrush="#DCE7EE" BorderThickness="0,0,0,1" Padding="12,13">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="142"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
                          <Grid Margin="0,0,12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Fill="#5685A5" Width="15" Height="22" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
                              <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource IconMouse}"/><Style.Triggers><DataTrigger Binding="{Binding TargetType}" Value="Keyboard"><Setter Property="Data" Value="{StaticResource IconKeyboard}"/></DataTrigger><DataTrigger Binding="{Binding Behavior}" Value="Sequence"><Setter Property="Data" Value="{StaticResource IconBolt}"/></DataTrigger></Style.Triggers></Style></Path.Style>
                            </Path>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding BehaviorSummary}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                          </Grid>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding HotkeyLabel}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ExecutionCount, StringFormat='Runs: {0:N0}'}" Foreground="#627B8D" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding HotkeyStatus}" Foreground="#A14E2E" FontSize="11" TextWrapping="Wrap">
                              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Click="Edit_Click" Tag="{Binding}" ToolTip="Edit macro" AutomationProperties.Name="Edit macro" Width="29" Padding="6,4" Margin="0,0,5,0"><Path Data="{StaticResource IconEdit}" Fill="#3B637C" Width="12" Height="12" Stretch="Uniform"/></Button>
                            <Button Click="Delete_Click" Tag="{Binding}" ToolTip="Delete macro" AutomationProperties.Name="Delete macro" Width="29" Padding="6,4" Margin="0,0,8,0"><Path Data="{StaticResource IconTrash}" Fill="#895D56" Width="12" Height="12" Stretch="Uniform"/></Button>
                            <Button Click="Toggle_Click" Tag="{Binding}" Width="66">
                              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Content" Value="Start"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Content" Value="Stop"/><Setter Property="Background" Value="{StaticResource StopBrush}"/><Setter Property="BorderBrush" Value="#C58E82"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="MacroRow" Property="Background" Value="#EBF6FD"/></DataTrigger></DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </ScrollViewer>
            </Border>
          </Grid>
          <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#A14E2E" TextWrapping="Wrap" Margin="12,0,12,5"/>
          <Border Grid.Row="3" BorderBrush="#C7D9E4" BorderThickness="0,1,0,0" Background="#EAF3F8" Padding="12,0">
            <Grid><TextBlock Text="Stop all: Ctrl + Shift + F12" FontSize="11" Foreground="#526B7C" VerticalAlignment="Center"/><TextBlock Text="Alpha-01" FontSize="11" Foreground="#526B7C" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
