<Window x:Class="Keyloom.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Keyloom.Views"
        Title="Keyloom" Style="{StaticResource {x:Type Window}}" Width="1000" Height="700" MinWidth="700" MinHeight="460" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <!-- ClearType needs to be asked for: the window is drawn on a transparent (acrylic) surface, where WPF would fall back to grey text. -->
  <Border Background="{DynamicResource ShellBrush}" CornerRadius="8" RenderOptions.ClearTypeHint="Enabled">
    <Grid>
      <Rectangle Fill="{DynamicResource AuroraBrush}" IsHitTestVisible="False"/>
      <Rectangle Fill="{DynamicResource AuroraAltBrush}" IsHitTestVisible="False"/>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Image Source="/Keyloom;component/Assets/keyloom.ico" Width="18" Height="18" Margin="0,0,9,0"/>
            <TextBlock Text="Keyloom" Style="{StaticResource CaptionText}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Click="Minimize_Click" Style="{StaticResource CaptionButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="{StaticResource IconMinimize}" Style="{StaticResource ChromeIcon}"/></Button>
            <Button Click="Maximize_Click" Style="{StaticResource CaptionButton}" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"><Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"/></Button>
            <Button Click="Hide_Click" Style="{StaticResource CloseCaptionButton}" ToolTip="Close to tray" AutomationProperties.Name="Close to tray"><Path Data="{StaticResource IconClose}" Style="{StaticResource ChromeIcon}"/></Button>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="18,2,18,0" Style="{StaticResource ShellContent}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <!-- Page header: title on the left, page actions on the right -->
          <Grid x:Name="Header" Margin="2,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource IconButton}" Width="34" Height="34" Margin="-6,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Back (Esc)" AutomationProperties.Name="Back">
              <Path Data="{StaticResource IconBack}" Style="{StaticResource Icon}" Width="15" Height="15"/>
            </Button>
            <StackPanel x:Name="TitlePanel" Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="PageTitle" Text="Macros" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="PageSubtitle" Text="Shortcuts work everywhere, even while Keyloom sits in the tray." Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel x:Name="ListActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="FilesButton" Click="Files_Click" Style="{StaticResource IconButton}" ToolTip="Import or export macros" AutomationProperties.Name="Import or export macros" Margin="0,0,2,0">
                <Path Data="{StaticResource IconFolder}" Style="{StaticResource Icon}" Width="15" Height="15"/>
                <Button.ContextMenu>
                  <ContextMenu x:Name="FilesMenu" Placement="Bottom">
                    <MenuItem Header="Import macros..." Click="Import_Click" ToolTip="Adds the macros from a .keyloom file. You can also drop the file on this window."><MenuItem.Icon><Path Data="{StaticResource IconUpload}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="ExportAllItem" Header="Export all macros..." Click="ExportAll_Click"><MenuItem.Icon><Path Data="{StaticResource IconDownload}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="ExportOneItem" Header="Export one macro"><MenuItem.Icon><Path Data="{StaticResource IconDownload}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Click="Settings_Click" Style="{StaticResource IconButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Margin="0,0,2,0"><Path Data="{StaticResource IconSettings}" Style="{StaticResource Icon}" Width="15" Height="15"/></Button>
              <Button Click="Help_Click" Style="{StaticResource IconButton}" ToolTip="Help" AutomationProperties.Name="Help" Margin="0,0,8,0"><Path Data="{StaticResource IconHelp}" Style="{StaticResource Icon}" Width="16" Height="16"/></Button>
              <Button Click="Stop_Click" Margin="0,0,8,0" ToolTip="Stop all macros (Ctrl + Shift + F12)">
                <StackPanel Orientation="Horizontal"><Border Width="8" Height="8" CornerRadius="1.5" Background="{DynamicResource RecordBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Stop all"/></StackPanel>
              </Button>
              <Button Click="Add_Click" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlus}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="New macro"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Margin="0,0,0,10">
            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Banner}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"/>
          </Border>
          <Grid x:Name="Pages" Grid.Row="2">
            <!-- Macro list -->
            <Grid x:Name="ListPage" RenderOptions.ClearTypeHint="Enabled">
              <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
              <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentTileBrush}" HorizontalAlignment="Center"><Path Data="{StaticResource IconBolt}" Fill="{DynamicResource AccentBrush}" Width="18" Height="24" Stretch="Uniform"/></Border>
                <TextBlock Text="No macros yet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,3"/>
                <TextBlock Text="Create your first macro with New macro." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
              </StackPanel>
              <!-- Top padding leaves room for the shadow of the first row -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-4,-6,-14,0" Padding="4,6,14,0">
                <ItemsControl x:Name="ProfilesItemsControl" Margin="0,0,0,6">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <!-- Rows stay put on hover: only the outline and fill change, so nothing jumps or gets clipped. -->
                    <Grid x:Name="RowRoot" Margin="0,0,0,8" RenderOptions.ClearTypeHint="Enabled">
                      <Grid.RenderTransform><TranslateTransform x:Name="RowShift"/></Grid.RenderTransform>
                      <Border x:Name="MacroRow" Style="{StaticResource Card}" Padding="14,12" Effect="{DynamicResource CardShadow}"/>
                      <Border x:Name="RowHover" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource HoverBorderBrush}" Background="{DynamicResource RowHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                      <Border x:Name="ActiveGlow" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource ActiveFillBrush}" Opacity="0" IsHitTestVisible="False"/>
                      <Border x:Name="ActiveBar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,16" Background="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False"/>
                      <Grid Margin="14,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="186"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <!-- Icon: click to change it -->
                        <Button x:Name="IconButton" Click="RowIcon_Click" Tag="{Binding}" Style="{StaticResource RowIconButton}" Margin="0,0,14,0" ToolTip="Change icon" AutomationProperties.Name="Change icon">
                          <Grid>
                            <Border x:Name="IconTileActive" CornerRadius="10" Background="{DynamicResource BlueButtonBrush}" Opacity="0"/>
                            <local:MacroIcon x:Name="RowIcon" Kind="{Binding IconKind}" Glyph="{Binding IconGlyph}" Image="{Binding IconImage}" Behavior="{Binding Behavior}" Target="{Binding TargetType}" Foreground="{DynamicResource AccentBrush}" SymbolSize="17"/>
                          </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                          <!-- Name: click to rename, Enter keeps it, Esc goes back -->
                          <Grid HorizontalAlignment="Left">
                            <Border x:Name="NameChip" Style="{StaticResource EditableChip}" MouseLeftButtonUp="RowName_Click" Tag="{Binding}" ToolTip="Click to rename">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <TextBox x:Name="NameBox" Text="{Binding Name, Mode=OneWay}" Tag="{Binding}" FontWeight="SemiBold" FontSize="14" MinHeight="0" Padding="4,1" Margin="-5,-3,0,-3" MinWidth="220" MaxLength="80"
                                     Visibility="Collapsed" KeyDown="NameBox_KeyDown" LostKeyboardFocus="NameBox_LostFocus" IsVisibleChanged="NameBox_IsVisibleChanged" AutomationProperties.Name="Macro name"/>
                          </Grid>
                          <TextBlock x:Name="Summary" Text="{Binding BehaviorSummary}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                          <TextBlock x:Name="RunLine" Text="{Binding RunText}" Foreground="{DynamicResource AccentBrush}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                          <!-- Shortcut: click, then press the new keys -->
                          <Button x:Name="ShortcutButton" Click="RowShortcut_Click" Tag="{Binding}" Style="{StaticResource KeycapButton}" HorizontalAlignment="Left"
                                  PreviewKeyDown="RowShortcut_KeyDown" LostKeyboardFocus="RowShortcut_LostFocus" ToolTip="Click, then press a new shortcut" AutomationProperties.Name="Change shortcut">
                            <Grid>
                              <TextBlock x:Name="ShortcutText" Text="{Binding HotkeyLabel}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock x:Name="CaptureText" Text="Press keys..." Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                            </Grid>
                          </Button>
                          <TextBlock x:Name="UsageLine" Text="{Binding UsageText}" Style="{StaticResource Muted}" FontSize="11.5" Margin="1,5,0,0" TextTrimming="CharacterEllipsis"/>
                          <TextBlock x:Name="CaptureHint" Text="Esc cancels, Backspace removes" Style="{StaticResource Muted}" FontSize="11.5" Margin="1,5,0,0" Visibility="Collapsed"/>
                          <TextBlock Text="{Binding HotkeyStatus}" Foreground="{DynamicResource DangerTextBrush}" FontSize="11.5" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Click="Edit_Click" Tag="{Binding}" Style="{StaticResource IconButton}" ToolTip="Edit steps and settings" AutomationProperties.Name="Edit macro" Margin="0,0,2,0"><Path Data="{StaticResource IconEdit}" Style="{StaticResource Icon}" Width="13" Height="13"/></Button>
                          <Button Click="Delete_Click" Tag="{Binding}" Style="{StaticResource IconButton}" ToolTip="Delete macro" AutomationProperties.Name="Delete macro" Margin="0,0,10,0"><Path Data="{StaticResource IconTrash}" Fill="{DynamicResource DangerIconBrush}" Width="13" Height="13" Stretch="Uniform"/></Button>
                          <Button Click="Toggle_Click" Tag="{Binding}" Width="74">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Content" Value="Start"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Content" Value="Stop"/><Setter Property="Background" Value="{DynamicResource StopBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StopBorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Grid>
                    <DataTemplate.Triggers>
                      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard><Storyboard>
                          <DoubleAnimation Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" FillBehavior="Stop"/>
                          <DoubleAnimation Storyboard.TargetName="RowShift" Storyboard.TargetProperty="Y" From="8" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource EaseOutStrong}"/>
                        </Storyboard></BeginStoryboard>
                      </EventTrigger>
                      <EventTrigger RoutedEvent="UIElement.MouseEnter">
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
                      </EventTrigger>
                      <EventTrigger RoutedEvent="UIElement.MouseLeave">
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/></Storyboard></BeginStoryboard>
                      </EventTrigger>
                      <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                        <Setter TargetName="NameChip" Property="Visibility" Value="Hidden"/><Setter TargetName="NameBox" Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                        <Setter TargetName="ShortcutText" Property="Visibility" Value="Hidden"/><Setter TargetName="CaptureText" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="UsageLine" Property="Visibility" Value="Collapsed"/><Setter TargetName="CaptureHint" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="ShortcutButton" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      </DataTrigger>
                      <!-- Running: a steady accent edge and the live time; nothing blinks. -->
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter TargetName="RowIcon" Property="Foreground" Value="White"/>
                        <Setter TargetName="Summary" Property="Visibility" Value="Collapsed"/><Setter TargetName="RunLine" Property="Visibility" Value="Visible"/>
                        <DataTrigger.EnterActions>
                          <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="ActiveBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="IconTileActive" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                          </Storyboard></BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                          <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                            <DoubleAnimation Storyboard.TargetName="ActiveBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                            <DoubleAnimation Storyboard.TargetName="IconTileActive" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                          </Storyboard></BeginStoryboard>
                        </DataTrigger.ExitActions>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- One icon picker serves every row -->
              <Popup x:Name="RowIconPopup" Placement="Bottom" VerticalOffset="4" HorizontalOffset="-10" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="RowIconPopup_Closed">
                <local:IconPicker x:Name="RowIconPicker" Changed="RowIconPicker_Changed" CloseRequested="RowIconPicker_CloseRequested" Failed="RowIconPicker_Failed"/>
              </Popup>
              <Grid Grid.Row="1" Margin="2,0">
                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Top"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Stop all" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <Border Style="{StaticResource Keycap}" Padding="5,0"><TextBlock Text="Ctrl + Shift + F12"/></Border>
                  <TextBlock Text="Click a name, icon or shortcut to change it" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <!-- The version opens About: what's new and whether a newer version is out -->
                <Button x:Name="VersionButton" Click="About_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip="What's new and updates" AutomationProperties.Name="About Keyloom and updates">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Chip" CornerRadius="9" Padding="7,1" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                          <TextBlock x:Name="VersionText" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverFillBrush}"/><Setter TargetName="VersionText" Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverFillBrush}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
            </Grid>
            <!-- Editor, settings and help pages -->
            <ContentControl x:Name="PageHost" Visibility="Collapsed" Focusable="False" IsTabStop="False" RenderOptions.ClearTypeHint="Enabled">
              <ContentControl.RenderTransform><TranslateTransform/></ContentControl.RenderTransform>
            </ContentControl>
          </Grid>
        </Grid>
        <local:SheetLayer x:Name="Sheets" Grid.Row="1"/>
      </Grid>
    </Grid>
  </Border>
</Window>
