<Window x:Class="Keyloom.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Keyloom" Style="{StaticResource {x:Type Window}}" Width="740" Height="510" MinWidth="620" MinHeight="400" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></shell:WindowChrome.WindowChrome>
  <Border Background="{StaticResource PageBrush}" BorderBrush="#303748" BorderThickness="1" Padding="22">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <StackPanel Orientation="Horizontal">
          <Border Width="40" Height="40" Background="#222B3D" CornerRadius="10" Margin="0,0,12,0">
            <Canvas Width="24" Height="24"><Path Data="M6 6V18" Stroke="#38BDF8" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M18 6L12 12L18 18" Stroke="#34D399" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas>
          </Border>
          <StackPanel><TextBlock Text="Keyloom" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Keyboard &amp; mouse macros" Style="{StaticResource Muted}"/></StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Click="Help_Click" Content="Help" Margin="0,0,8,0"/>
          <Button Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" Width="34" Padding="8" Margin="0,0,4,0"><Path Data="{StaticResource IconMinimize}" Fill="#A0ABBD" Width="12" Height="12" Stretch="Uniform"/></Button>
          <Button Click="Hide_Click" ToolTip="Close to tray" AutomationProperties.Name="Close to tray" Width="34" Padding="8"><Path Data="{StaticResource IconClose}" Fill="#A0ABBD" Width="12" Height="12" Stretch="Uniform"/></Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,14">
        <StackPanel><TextBlock Text="Your macros" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Use a shortcut or press Start." Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
        <Button Content="Add macro" Click="Add_Click" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"/>
      </Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <TextBlock x:Name="EmptyText" Text="No macros yet. Add your first macro above." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <ItemsControl x:Name="ProfilesItemsControl">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="{StaticResource CardBrush}" CornerRadius="10" BorderBrush="#303748" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding BehaviorSummary}" Style="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <TextBlock Text="{Binding HotkeyLabel}" Foreground="#73D0F5" FontSize="12"/>
                      <TextBlock Text="{Binding ExecutionCount, StringFormat='  ·  Runs: {0:N0}'}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyStatus}" Foreground="#FBBF24" FontSize="12" TextWrapping="Wrap">
                      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Edit_Click" Tag="{Binding}" ToolTip="Edit macro" AutomationProperties.Name="Edit macro" Width="34" Padding="8" Margin="0,0,6,0"><Path Data="{StaticResource IconEdit}" Fill="#D1DAE8" Width="13" Height="13" Stretch="Uniform"/></Button>
                    <Button Click="Delete_Click" Tag="{Binding}" ToolTip="Delete macro" AutomationProperties.Name="Delete macro" Width="34" Padding="8" Margin="0,0,8,0"><Path Data="{StaticResource IconTrash}" Fill="#EAA0AA" Width="13" Height="13" Stretch="Uniform"/></Button>
                    <Button Click="Toggle_Click" Tag="{Binding}" Width="76">
                      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Content" Value="Start"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Content" Value="Stop"/><Setter Property="Background" Value="#EF727E"/><Setter Property="BorderBrush" Value="#EF727E"/></DataTrigger></Style.Triggers>
                      </Style></Button.Style>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>
      <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Grid Grid.Row="4" Margin="0,16,0,0">
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Stop all: Ctrl + Shift + F12" Style="{StaticResource Muted}"/><TextBlock Text="Alpha-01" Foreground="#A0ABBD" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        <Button Content="Stop all" Click="Stop_Click" HorizontalAlignment="Right"/>
      </Grid>
    </Grid>
  </Border>
</Window>
