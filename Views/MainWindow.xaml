<Window x:Class="Keyloom.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Keyloom" Style="{StaticResource {x:Type Window}}" Width="760" Height="480" MinWidth="640" MinHeight="360" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource ShellBrush}" CornerRadius="8">
    <Grid>
      <Rectangle Fill="{StaticResource AuroraBrush}" IsHitTestVisible="False"/>
      <Rectangle Fill="{StaticResource AuroraAltBrush}" IsHitTestVisible="False"/>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Image Source="/Keyloom;component/Assets/keyloom.ico" Width="18" Height="18" Margin="0,0,9,0"/>
            <TextBlock Text="Keyloom" FontSize="12" Foreground="#2C4A60" VerticalAlignment="Center"/>
            <Border Style="{StaticResource Pill}" Margin="9,0,0,0" Padding="7,1"><TextBlock Text="Alpha-01" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/></Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Click="Minimize_Click" Style="{StaticResource CaptionButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="{StaticResource IconMinimize}" Style="{StaticResource ChromeIcon}"/></Button>
            <Button Click="Maximize_Click" Style="{StaticResource CaptionButton}" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"><Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"/></Button>
            <Button Click="Hide_Click" Style="{StaticResource CloseCaptionButton}" ToolTip="Close to tray" AutomationProperties.Name="Close to tray"><Path Data="{StaticResource IconClose}" Style="{StaticResource ChromeIcon}"/></Button>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="18,2,18,0" Style="{StaticResource ShellContent}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
          <Grid Margin="2,0,0,14">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Macros" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold" Foreground="#14324A"/>
              <TextBlock Text="Shortcuts work everywhere, even while Keyloom sits in the tray." Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Click="Help_Click" Style="{StaticResource IconButton}" ToolTip="Help" AutomationProperties.Name="Help" Margin="0,0,6,0"><TextBlock Text="?" FontSize="14" FontWeight="SemiBold" Foreground="#3B5D75"/></Button>
              <Button Click="Stop_Click" Margin="0,0,8,0" ToolTip="Stop all macros (Ctrl + Shift + F12)">
                <StackPanel Orientation="Horizontal"><Border Width="8" Height="8" CornerRadius="1.5" Background="#B8402F" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Stop all"/></StackPanel>
              </Button>
              <Button Click="Add_Click" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlus}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="New macro"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Background="#1FC42B1C" BorderBrush="#40C42B1C" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap"/>
          </Border>
          <Grid Grid.Row="2">
            <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource AccentTileBrush}" HorizontalAlignment="Center"><Path Data="{StaticResource IconBolt}" Fill="{StaticResource AccentBrush}" Width="18" Height="24" Stretch="Uniform"/></Border>
              <TextBlock Text="No macros yet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,3"/>
              <TextBlock Text="Create your first macro with New macro." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-4,0,-14,0" Padding="4,0,14,0">
              <ItemsControl x:Name="ProfilesItemsControl" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Grid x:Name="RowRoot" Margin="0,0,0,8" RenderTransformOrigin=".5,.5">
                    <Grid.RenderTransform><TranslateTransform x:Name="RowShift"/></Grid.RenderTransform>
                    <Border x:Name="MacroRow" Style="{StaticResource Card}" Padding="14,12" Effect="{StaticResource CardShadow}"/>
                    <Border x:Name="RowHover" CornerRadius="10" BorderThickness="1" BorderBrush="#8047A3F3" Background="#40FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="ActiveGlow" CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource AccentBrush}" Background="#140F6CBD" Opacity="0" IsHitTestVisible="False"/>
                    <Grid Margin="14,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border x:Name="IconTile" CornerRadius="10" Background="{StaticResource AccentTileBrush}"/>
                        <Border x:Name="IconTileActive" CornerRadius="10" Background="{StaticResource BlueButtonBrush}" Opacity="0"/>
                        <Path x:Name="RowIcon" Fill="{StaticResource AccentBrush}" Width="16" Height="20" Stretch="Uniform">
                          <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource IconMouse}"/><Style.Triggers><DataTrigger Binding="{Binding TargetType}" Value="Keyboard"><Setter Property="Data" Value="{StaticResource IconKeyboard}"/></DataTrigger><DataTrigger Binding="{Binding Behavior}" Value="Sequence"><Setter Property="Data" Value="{StaticResource IconBolt}"/></DataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                          <Border x:Name="RunningBadge" Style="{StaticResource Pill}" Background="#212E9E6B" Margin="8,0,0,0" Padding="7,1" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                              <Ellipse x:Name="PulseDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock Text="Running" FontSize="10" FontWeight="SemiBold" Foreground="#1F7A51"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding BehaviorSummary}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Background="#B3FFFFFF" BorderBrush="#2E0F3550" BorderThickness="1" CornerRadius="5" Padding="7,2">
                          <TextBlock Text="{Binding HotkeyLabel}" FontSize="11" FontFamily="Segoe UI Variable Text Semibold, Segoe UI" Foreground="#2C4A60" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock Text="{Binding ExecutionCount, StringFormat='Runs: {0:N0}'}" Style="{StaticResource Muted}" FontSize="11" Margin="1,4,0,0"/>
                        <TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource DangerTextBrush}" FontSize="11" TextWrapping="Wrap">
                          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="Edit_Click" Tag="{Binding}" Style="{StaticResource IconButton}" ToolTip="Edit macro" AutomationProperties.Name="Edit macro" Margin="0,0,2,0"><Path Data="{StaticResource IconEdit}" Fill="#3B637C" Width="13" Height="13" Stretch="Uniform"/></Button>
                        <Button Click="Delete_Click" Tag="{Binding}" Style="{StaticResource IconButton}" ToolTip="Delete macro" AutomationProperties.Name="Delete macro" Margin="0,0,10,0"><Path Data="{StaticResource IconTrash}" Fill="#A2564A" Width="13" Height="13" Stretch="Uniform"/></Button>
                        <Button Click="Toggle_Click" Tag="{Binding}" Width="74">
                          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Content" Value="Start"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Content" Value="Stop"/><Setter Property="Background" Value="{StaticResource StopBrush}"/><Setter Property="BorderBrush" Value="#9E2A1E"/><Setter Property="Effect" Value="{StaticResource DangerGlow}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Grid>
                  <DataTemplate.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                        <DoubleAnimation Storyboard.TargetName="RowShift" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource EaseOutStrong}"/>
                      </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                      <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="RowShift" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
                      </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                      <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                        <DoubleAnimation Storyboard.TargetName="RowShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}"/>
                      </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter TargetName="RunningBadge" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="RowIcon" Property="Fill" Value="White"/>
                      <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="ActiveIn"><Storyboard>
                          <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                          <DoubleAnimation Storyboard.TargetName="IconTileActive" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                        </Storyboard></BeginStoryboard>
                        <BeginStoryboard x:Name="Pulse"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                          <DoubleAnimation Storyboard.TargetName="PulseDot" Storyboard.TargetProperty="Opacity" From="1" To=".25" Duration="0:0:0.7"/>
                        </Storyboard></BeginStoryboard>
                      </DataTrigger.EnterActions>
                      <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse"/>
                        <BeginStoryboard><Storyboard>
                          <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                          <DoubleAnimation Storyboard.TargetName="IconTileActive" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                        </Storyboard></BeginStoryboard>
                      </DataTrigger.ExitActions>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <Grid Grid.Row="3" Margin="2,0">
            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Stop all" Style="{StaticResource Muted}" FontSize="11"/>
              <TextBlock Text="Ctrl + Shift + F12" FontSize="11" Foreground="#2C4A60" Margin="6,0,16,0"/>
              <TextBlock Text="Show or hide" Style="{StaticResource Muted}" FontSize="11"/>
              <TextBlock Text="Ctrl + Shift + I" FontSize="11" Foreground="#2C4A60" Margin="6,0,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
