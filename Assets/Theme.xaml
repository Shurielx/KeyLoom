<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint=".8,1">
    <GradientStop Color="#D9EFF9" Offset="0"/><GradientStop Color="#A7CADF" Offset=".4"/><GradientStop Color="#D9EDF7" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#ECF8FF" Offset="0"/><GradientStop Color="#D3EDF9" Offset=".48"/><GradientStop Color="#ADD1E7" Offset=".5"/><GradientStop Color="#DBEFF8" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#EDF3F7" Offset=".48"/><GradientStop Color="#D9E5ED" Offset=".5"/><GradientStop Color="#F0F5F8" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BlueButtonBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F5FCFF" Offset="0"/><GradientStop Color="#D1EEFD" Offset=".48"/><GradientStop Color="#A6D5EF" Offset=".5"/><GradientStop Color="#DAF1FC" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PressedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#A2CDE5" Offset="0"/><GradientStop Color="#D2EAF7" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="StopBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFF6F4" Offset="0"/><GradientStop Color="#F7DDD7" Offset=".48"/><GradientStop Color="#EFB9B0" Offset=".5"/><GradientStop Color="#FBE7E3" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CardBrush" Color="#F4F8FB"/>
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource PageBrush}"/>
    <Setter Property="Foreground" Value="#19364B"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Icon" Value="/Keyloom;component/Assets/keyloom.ico"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#526B7C"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource ButtonBrush}"/><Setter Property="Foreground" Value="#19364B"/>
    <Setter Property="BorderBrush" Value="#8BA3B5"/><Setter Property="Padding" Value="12,5"/>
    <Setter Property="MinHeight" Value="28"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
        <Border BorderBrush="#BFFFFFFF" BorderThickness="1" CornerRadius="2">
          <Grid>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            <Rectangle x:Name="Focus" Margin="3" RadiusX="1" RadiusY="1" Stroke="#386784" StrokeDashArray="1 2" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
        </Border>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource BlueButtonBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="#3985B4"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PressedBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource BlueButtonBrush}"/><Setter Property="BorderBrush" Value="#5995B9"/>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Width" Value="30"/>
    <Setter Property="Padding" Value="6,3"/><Setter Property="Background" Value="#45FFFFFF"/><Setter Property="BorderBrush" Value="#6B8BA4"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#19364B"/>
    <Setter Property="CaretBrush" Value="#19364B"/><Setter Property="SelectionBrush" Value="#9DCBE8"/>
    <Setter Property="BorderBrush" Value="#96ADBE"/><Setter Property="Padding" Value="7,5"/><Setter Property="MinHeight" Value="29"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
        <ScrollViewer x:Name="PART_ContentHost"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#327EAC"/></Trigger>
        <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Field" Property="Background" Value="#F2F7FA"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value=".55"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource ButtonBrush}"/><Setter Property="Foreground" Value="#19364B"/>
    <Setter Property="MinHeight" Value="29"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton x:Name="DropButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="#96ADBE" BorderThickness="1" CornerRadius="2">
              <Border BorderBrush="#BFFFFFFF" BorderThickness="1">
                <Path Data="M0 0L4 4L8 0Z" Fill="#355B72" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
              </Border>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#327EAC"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,5,26,5" IsHitTestVisible="False" VerticalAlignment="Center"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="#FFFFFF" BorderBrush="#7B9DB5" BorderThickness="1" Padding="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropButton" Property="Background" Value="{StaticResource BlueButtonBrush}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#19364B"/><Setter Property="Padding" Value="7,5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Item" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource BlueButtonBrush}"/><Setter TargetName="Item" Property="BorderBrush" Value="#A4C8DE"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#19364B"/><Setter Property="BorderBrush" Value="#A7BBC9"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Item" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource BlueButtonBrush}"/><Setter TargetName="Item" Property="BorderBrush" Value="#85B5D2"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#85B5D2"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
