<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="PageBrush" Color="#101117"/>
  <SolidColorBrush x:Key="CardBrush" Color="#191C26"/>
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource PageBrush}"/>
    <Setter Property="Foreground" Value="#EEF2F7"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Icon" Value="/Keyloom;component/Assets/keyloom.ico"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#A0ABBD"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="#282D3D"/><Setter Property="Foreground" Value="#F1F5F9"/>
    <Setter Property="BorderBrush" Value="#394158"/><Setter Property="Padding" Value="12,8"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".82"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#38BDF8"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#38BDF8"/><Setter Property="Foreground" Value="#0B1622"/><Setter Property="BorderBrush" Value="#38BDF8"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#11141C"/><Setter Property="Foreground" Value="#F1F5F9"/>
    <Setter Property="CaretBrush" Value="#38BDF8"/><Setter Property="BorderBrush" Value="#45516A"/>
    <Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="#232838"/><Setter Property="Foreground" Value="#F1F5F9"/>
    <Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" Foreground="#F1F5F9" BorderBrush="#45516A">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><Grid><ContentPresenter/><Path Data="M0 0L4 4L8 0" Stroke="#A0ABBD" StrokeThickness="1.5" Width="8" Height="4" HorizontalAlignment="Right" Margin="0,0,12,0"/></Grid></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,7,30,7" IsHitTestVisible="False" VerticalAlignment="Center"/>
        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="#232838" BorderBrush="#45516A" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="Padding" Value="10,8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Item" Background="Transparent"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#36415A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#303B50"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#11141C"/><Setter Property="Foreground" Value="#EEF2F7"/><Setter Property="BorderBrush" Value="#354157"/></Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Item" Background="Transparent" CornerRadius="5"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#2C3D55"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
