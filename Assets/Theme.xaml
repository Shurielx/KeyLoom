<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colors live in Colors.Light.xaml (the base) and Colors.Dark.xaml. Styles use DynamicResource so the theme can change live. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Keyloom;component/Assets/Colors.Light.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
  <QuarticEase x:Key="EaseOutStrong" EasingMode="EaseOut"/>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

  <!-- Base -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource ShellBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="Icon" Value="/Keyloom;component/Assets/keyloom.ico"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource SectionBrush}"/>
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource InkStrongBrush}"/>
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Icon" TargetType="Path">
    <Setter Property="Fill" Value="{DynamicResource IconBrush}"/><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="AccentIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- Shell entrance: slides content up and fades it in once it loads -->
  <Style x:Key="ShellContent" TargetType="FrameworkElement">
    <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
    <Style.Triggers>
      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
        <BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.42" EasingFunction="{StaticResource EaseOutStrong}"/>
        </Storyboard></BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FocusRing">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Border Margin="-3" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" SnapsToDevicePixels="True"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Buttons -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="Padding" Value="14,6"/>
    <Setter Property="MinHeight" Value="30"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid x:Name="Root" RenderTransformOrigin=".5,.5" SnapsToDevicePixels="True">
        <Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
        <Border x:Name="Hover" Background="{DynamicResource HoverFillBrush}" BorderBrush="{DynamicResource HoverBorderBrush}" BorderThickness="1" CornerRadius="6" Opacity="0"/>
        <Border Margin="1" BorderBrush="{DynamicResource TopHighlightBrush}" BorderThickness="0,1,0,0" CornerRadius="5" IsHitTestVisible="False"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To=".96" Duration="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To=".96" Duration="0:0:0.08"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource BlueButtonBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BlueButtonBorderBrush}"/>
    <Setter Property="Foreground" Value="White"/><Setter Property="Effect" Value="{DynamicResource AccentGlow}"/>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource StopBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StopBorderBrush}"/>
    <Setter Property="Foreground" Value="White"/><Setter Property="Effect" Value="{DynamicResource DangerGlow}"/>
  </Style>
  <!-- Transparent button for icons and quiet text actions -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
        <Border x:Name="Hover" Background="{DynamicResource SubtleFillBrush}" CornerRadius="6" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To=".92" Duration="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To=".92" Duration="0:0:0.08"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="9,4"/>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/>
    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/><Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
        <Border x:Name="Hover" Background="{TemplateBinding Background}" Opacity="0"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".7"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Background" Value="#C42B1C"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="ChromeIcon" TargetType="Path">
    <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/><Setter Property="Stretch" Value="Uniform"/>
  </Style>

  <!-- Segmented control: RadioButtons inside a SegmentBar border -->
  <Style x:Key="SegmentBar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="26"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid Background="Transparent">
        <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource ListHoverBrush}" Opacity="0"/>
        <Border x:Name="Thumb" CornerRadius="6" Background="{DynamicResource ButtonBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Opacity="0" Effect="{DynamicResource CardShadow}"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Large selectable card (macro type, icon choice). Content is laid out by the caller. -->
  <Style x:Key="ChoiceCard" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid x:Name="Root" RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="10"/>
        <Border x:Name="Hover" Background="{DynamicResource ListHoverBrush}" BorderBrush="{DynamicResource HoverBorderBrush}" BorderThickness="1" CornerRadius="10" Opacity="0"/>
        <Border x:Name="Selected" Background="{DynamicResource ActiveFillBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="10" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" From=".97" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOutStrong}"/>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" From=".97" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOutStrong}"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Text input with an animated accent underline -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/><Setter Property="SelectionBrush" Value="#5A47A3F3"/>
    <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Grid x:Name="Root" SnapsToDevicePixels="True">
        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
          <ScrollViewer x:Name="PART_ContentHost" Margin="1,0"/>
        </Border>
        <Border x:Name="Underline" Height="2" CornerRadius="1" Margin="5,0,5,0.5" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" RenderTransformOrigin=".5,.5">
          <Border.RenderTransform><ScaleTransform x:Name="UnderlineScale" ScaleX="0"/></Border.RenderTransform>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource FieldBorderHoverBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Field" Property="Background" Value="{DynamicResource FieldFocusBrush}"/>
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Field" Property="Background" Value="{DynamicResource FieldReadOnlyBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- ComboBox with sliding popup and rotating chevron -->
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="MinHeight" Value="32"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid SnapsToDevicePixels="True">
        <ToggleButton x:Name="DropButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6"/>
              <Border x:Name="Hover" Background="{DynamicResource HoverFillBrush}" BorderBrush="{DynamicResource HoverBorderBrush}" BorderThickness="1" CornerRadius="6" Opacity="0"/>
              <Border Margin="1" BorderBrush="{DynamicResource TopHighlightBrush}" BorderThickness="0,1,0,0" CornerRadius="5"/>
              <Path Data="M0 0L4.5 4.5L9 0" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Width="9" Height="5" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" RenderTransformOrigin=".5,.5">
                <Path.RenderTransform><RotateTransform x:Name="Chevron"/></Path.RenderTransform>
              </Path>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,5,30,5" IsHitTestVisible="False" VerticalAlignment="Center"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="2" HorizontalOffset="-8" AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
          <Border Margin="8,0,8,14" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Effect="{DynamicResource PopupShadow}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Grid Margin="0,1">
        <Border x:Name="Item" CornerRadius="5" Background="{DynamicResource SubtleFillBrush}" Opacity="0"/>
        <Border x:Name="Pip" Width="3" Height="14" CornerRadius="1.5" HorizontalAlignment="Left" Margin="2,0,0,0" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
        <ContentPresenter Margin="{TemplateBinding Padding}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Pip" Property="Visibility" Value="Visible"/><Setter TargetName="Item" Property="Opacity" Value=".6"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Opacity" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Menus (Add step) -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border Margin="8,2,8,14" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Effect="{DynamicResource PopupShadow}">
        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,6,18,6"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Grid Background="Transparent" MinWidth="190">
        <Border x:Name="Item" CornerRadius="5" Background="{DynamicResource SubtleFillBrush}" Opacity="0"/>
        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </StackPanel>
        <TextBlock Text="{TemplateBinding InputGestureText}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
      <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="8,4"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MenuIcon" TargetType="Path">
    <Setter Property="Fill" Value="{DynamicResource IconBrush}"/><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Stretch" Value="Uniform"/>
  </Style>

  <!-- Lists -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False"><ItemsPresenter/></ScrollViewer>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Grid Margin="0,1" Background="Transparent">
        <Border x:Name="Hover" CornerRadius="5" Background="{DynamicResource ListHoverBrush}" Opacity="0"/>
        <Border x:Name="Selected" CornerRadius="5" Background="{DynamicResource ListSelectedBrush}" Opacity="0"/>
        <Border x:Name="Pip" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,0,0,0" Background="{DynamicResource AccentBrush}" RenderTransformOrigin=".5,.5">
          <Border.RenderTransform><ScaleTransform x:Name="PipScale" ScaleY="0"/></Border.RenderTransform>
        </Border>
        <ContentPresenter Margin="{TemplateBinding Padding}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="PipScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOutStrong}"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PipScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.15"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- CheckBox with animated check -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="18" Height="18" VerticalAlignment="Center">
          <Border x:Name="Box" CornerRadius="4" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource CheckBorderBrush}" BorderThickness="1"/>
          <Border x:Name="Fill" CornerRadius="4" Background="{DynamicResource BlueButtonBrush}" Opacity="0"/>
          <Path x:Name="Check" Data="M3.5 9L7.5 13L14.5 5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" RenderTransformOrigin=".5,.5" Opacity="0">
            <Path.RenderTransform><ScaleTransform x:Name="CheckScale" ScaleX=".4" ScaleY=".4"/></Path.RenderTransform>
          </Path>
        </Grid>
        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude=".5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude=".5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To=".4" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To=".4" Duration="0:0:0.15"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- On/off switch; content sits on the left, the switch on the right -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
        <Grid Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center">
          <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource SwitchTrackBrush}" BorderBrush="{DynamicResource CheckBorderBrush}" BorderThickness="1"/>
          <Border x:Name="On" CornerRadius="11" Background="{DynamicResource BlueButtonBrush}" Opacity="0"/>
          <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0" Effect="{DynamicResource CardShadow}">
            <Ellipse.RenderTransform><TranslateTransform x:Name="KnobShift"/></Ellipse.RenderTransform>
          </Ellipse>
        </Grid>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOutStrong}"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOutStrong}"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Disclosure toggle ("More options") -->
  <Style x:Key="Disclosure" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <StackPanel Orientation="Horizontal" Background="Transparent">
        <Path Data="M0 0L4.5 4.5L9 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="9" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,8,0" RenderTransformOrigin=".5,.5">
          <Path.RenderTransform><RotateTransform x:Name="Chevron" Angle="-90"/></Path.RenderTransform>
        </Path>
        <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Angle" To="-90" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Slider for preview time -->
  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Grid Width="16" Height="16" Background="Transparent">
        <Ellipse Fill="{DynamicResource BlueButtonBrush}" Stroke="White" StrokeThickness="2" Effect="{DynamicResource CardShadow}"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Height="20">
        <Border Height="4" CornerRadius="2" Background="{DynamicResource PillBrush}" VerticalAlignment="Center"/>
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
        </Track>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Slim scrollbars that widen on hover -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Border Background="Transparent"><Border x:Name="Bar" CornerRadius="3" Background="{DynamicResource ScrollThumbBrush}"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,3">
          <Track.Thumb><Thumb x:Name="Thumb" Style="{StaticResource ScrollThumb}" Width="4" HorizontalAlignment="Center"/></Track.Thumb>
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width" To="7" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width" To="4" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="12"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" Margin="3,0">
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Height="5" VerticalAlignment="Center"/></Track.Thumb>
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate></Setter.Value></Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <Border Margin="6,2,6,10" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,5" Effect="{DynamicResource PopupShadow}">
        <ContentPresenter TextElement.FontSize="12"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Setter Property="HasDropShadow" Value="False"/>
  </Style>

  <!-- Card used for grouped content -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- A key cap, used to show shortcuts -->
  <Style x:Key="Keycap" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource KeycapBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource KeycapBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1,1,1,2"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="7,2"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextElement.FontSize" Value="11"/>
    <Setter Property="TextElement.FontFamily" Value="Segoe UI Variable Text Semibold, Segoe UI"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InkSoftBrush}"/>
  </Style>
  <Style x:Key="IconTile" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource AccentTileBrush}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
  </Style>
  <Style x:Key="Banner" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource DangerFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,8"/>
  </Style>
</ResourceDictionary>
