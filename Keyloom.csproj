<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationTitle>Keyloom</ApplicationTitle>
    <AssemblyName>Keyloom</AssemblyName>
    <RootNamespace>Keyloom</RootNamespace>
    <Version>0.3.0</Version>
    <InformationalVersion>0.3-dev-1</InformationalVersion>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Product>Keyloom</Product>
    <Description>Keyboard and mouse macros for Windows</Description>
    <ApplicationIcon>Assets/keyloom.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Compile Remove="tests/**/*.cs" />
    <Page Remove="tests/**/*.xaml" />
    <Resource Include="Assets/keyloom.ico" />
    <!-- Shown offline on the About page; the newest copy comes from GitHub. -->
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="Keyloom.CHANGELOG.md" />
  </ItemGroup>
</Project>
